{% extends 'components/embedded-calendar/container.twig' %}
{% block calendar %}
<div class="booked-calendar-agenda">
    {% if Reservations.Reservations()|length == 0 %}
        {{ translate('NoReservationsFound') }}
    {% endif %}
    {% set LastDate = date_min() %}
    {% for r in Reservations.Reservations() %}
        {% if not r.StartDate().DateEquals(LastDate) %}
            <div class="booked-agenda-date">
                <a href="{{ ScheduleUrl }}{{ format_date(date: r.StartDate(), timezone: Timezone, key: 'url') }}"
                   title="{{ translate('ViewCalendar') }}">{{ format_date(date: r.StartDate(), timezone: Timezone) }}</a>
            </div>
        {% endif %}
        {{ include('components/embedded-calendar/event.twig', {r: r, date: r.StartDate()}) }}
        {% set LastDate = r.StartDate() %}
    {% endfor %}
</div>
{% endblock %}
