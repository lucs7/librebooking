{#
  tpl/components/common/accordion-item.twig
  Bootstrap `.accordion-item` panel shared by every dashboard widget. Use with
  `{% embed %}` and override `body` (required); `footer` is optional extra markup
  rendered inside the item but outside the collapsible content (e.g. a hidden form).
  `id`/`contentsId` are required; `title` is the (already translated) toggle button
  label; `badge` is an optional count shown next to the title; `open` (default false)
  renders the item expanded; `buttonClass` replaces the default
  `link-primary fw-bold` toggle styling (pass '' for the plain Bootstrap look). `title` may be
  a `{% set %}...{% endset %}` capture when it needs markup such as an icon.

  {% embed 'components/common/accordion-item.twig' with {
  'id': 'announcementsDashboard', 'contentsId': 'announcementsContents',
  'title': translate('Announcements'), 'badge': (Announcements ?? [])|length
  } %}
  {% block body %}...{% endblock %}
  {% endembed %}
#}
<div class="accordion-item shadow mb-2 {{ class|default('') }}" id='{{ id }}'>
  <div class='accordion-header'>
    <button
      class='accordion-button {{ open|default(false) ? '' : 'collapsed' }} {{ buttonClass ?? 'link-primary fw-bold' }}'
      type='button'
      data-bs-toggle='collapse'
      data-bs-target='#{{ contentsId }}'
      aria-expanded='{{ open|default(false) ? 'true' : 'false' }}'
      aria-controls='{{ contentsId }}'
    >
      {{ title -}}
      {%- if badge is defined and badge is not null -%}
        {{ include('components/common/badge.twig', {text: badge, class: 'ms-1'}, false) }}
      {%- endif %}
    </button>
  </div>
  <div id='{{ contentsId }}' class="accordion-collapse collapse {{ open|default(false) ? 'show' : '' }} {{ contentsClass|default('') }}">
    <div class="accordion-body {{ bodyClass|default('') }}">
      {% block body %}{% endblock %}
    </div>
  </div>
  {% block footer %}{% endblock %}
</div>
