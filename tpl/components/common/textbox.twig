{#
  Reusable Bootstrap-styled text/password/email input, based on the legacy
  `textbox()` plugin. Intended for pages that have moved off Smarty parity
  and are being migrated to declarative components.

  `key` is a FormKeys key, resolved via `formname()` for the `name` attribute
  and defaulted for `id` unless `id` is passed explicitly. `value` is rendered
  as-is — pass an already-resolved value (e.g. a posted form value fetched by
  the Page) to repopulate the field; omit for an empty input. `labelkey` is a
  translation key for the field's label, rendered bound to the input via
  for/id; omit to render the input without a label.

  {% include 'components/common/textbox.twig' with {
  'key': 'EMAIL', 'type': 'email', 'required': true, 'class': 'input',
  'labelkey': 'EmailAddress', 'labelClass': 'forgot fw-bold',
  'attributes': {'size': '20', 'tabindex': '10'}
  } only %}
#}
{% set extraAttrs -%}
{%- for attrName, attrValue in attributes|default({}) -%}
  {{- attrName }}='{{ attrValue }}'
{% endfor -%}
{%- endset %}
{% set inputId = id|default(formkey(key)) %}
{% if labelkey is defined and labelkey %}
  <label for='{{ inputId }}' class="{{ labelClass|default('form-label') }}">{{ translate(labelkey) }}</label>
  <br>
{% endif %}
<input
  type="{{ type|default('text') }}"
  {{ formname(key: key) }}
  id='{{ inputId }}'
  value="{{ value|default('') }}"
  {% if required is defined and required %}
    required='required'
  {% endif %}
  class="{{ class|default('') }} form-control form-control-sm"
  {% if placeholderkey is defined and placeholderkey %}
    placeholder='{{ translate(placeholderkey) }}'
  {% endif %}
  {{ extraAttrs|raw }}
>
