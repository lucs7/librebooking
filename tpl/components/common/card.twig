{#
  Reusable Bootstrap `.card`. Use with `{% embed 'components/common/card.twig' with {...} %}`
  and override the `header`, `body`, and `footer` blocks. Pass `class`/`bodyClass` for extra
  CSS classes on the outer card / `.card-body`, `id` for an id on the card, and `bodyId`
  for an id on the `.card-body`.
#}
{# capture the header block so the wrapper only renders when there's content #}
{% set headerContent -%}
{%- block header %}{% endblock -%}
{%- endset %}
<div id="{{ id|default('') }}" class="card shadow {{ class|default('') }}">
  {% if headerContent|trim != '' %}
    <div class='card-header'>
      {{ headerContent|raw }}
    </div>
  {% endif %}
  <div id="{{ bodyId|default('') }}" class="card-body {{ bodyClass|default('') }}">
    {% block body %}{% endblock %}
  </div>
  {% block footer %}{% endblock %}
</div>
