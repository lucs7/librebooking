{% if CanViewUser %}
	<div id="userDetailsPopup">
		<div class="card-header fw-bold">
			{{ fullname(User.FirstName()|html_entity_decode, User.LastName()|html_entity_decode, true) }}
		</div>
		<div id="userDetailsName" class="card-body">
			{% if User.EmailAddress() %}
				<div id="userDetailsEmail" class="fw-bold">
					<span class="label">{{ translate('Email') }}</span>
					<a href="mailto:{{ User.EmailAddress() }}" class="link-primary">{{ User.EmailAddress() }}</a>
				</div>
			{% endif %}
			{% if User.GetAttribute(constant('UserAttribute::Phone')) %}
				<div id="userDetailsPhone" class="fw-bold">
					<span class="label">{{ translate('Phone') }}</span>
					<a href="tel:{{ User.GetAttribute(constant('UserAttribute::Phone')) }}"
						class="link-primary">{{ User.GetAttribute(constant('UserAttribute::Phone')) }}</a>
				</div>
			{% endif %}
			{% if User.GetAttribute(constant('UserAttribute::Organization')) %}
				<div id="userDetailsOrganization" class="fw-bold">
					<span class="label">{{ translate('Organization') }}</span>
					{{ User.GetAttribute(constant('UserAttribute::Organization')) }}
				</div>
			{% endif %}
			{% if User.GetAttribute(constant('UserAttribute::Position')) %}
				<div id="userDetailsPosition" class="fw-bold">
					<span class="label">{{ translate('Position') }}</span>
					{{ User.GetAttribute(constant('UserAttribute::Position')) }}
				</div>
			{% endif %}
			<div id="userDetailsAttributes" class="fw-bold">
				{% for attribute in Attributes %}
					<div class="customAttribute">
						<span class="label">{{ attribute.Label() }}</span>
						{{ User.GetAttributeValue(attribute.Id()) }}
					</div>
				{% endfor %}
			</div>
		</div>
	</div>
{% endif %}
