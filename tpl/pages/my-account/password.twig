{% extends 'layouts/base.twig' %}

{% block content %}
  <div class='page-change-password'>
    {% if not (AllowPasswordChange is defined and AllowPasswordChange) %}
      <div class='alert alert-danger text-center'>
        <i class='bi bi-exclamation-triangle-fill fs-5'></i> {{ translate('PasswordControlledExternallyError') }}
      </div>
    {% else %}
      {% embed 'components/common/card.twig' with {id: 'password-reset-box', class: 'default-box col-12 col-sm-8 mx-auto'} %}
      {% block header %}
        <h1 class='text-center m-0'>{{ translate('ChangePassword') }}</h1>
      {% endblock %}
      {% block body %}
        <form id='password-reset-form' method='post' action='{{ server.SCRIPT_NAME }}'>
          {% if ResetPasswordSuccess is defined and ResetPasswordSuccess %}
            <div class='success alert alert-success'>
              <i class='bi bi-check-circle-fill'></i> {{ translate('PasswordChangedSuccessfully') }}
            </div>
          {% endif %}

          {% set _vg %}
          {{ validator(id: 'currentpassword', key: 'InvalidPassword') }}
          {{ validator(id: 'passwordmatch', key: 'PwMustMatch') }}
          {{ validator(id: 'passwordcomplexity', key: '') }}
          {% endset %}
          {{ validation_group(_vg, 'alert alert-danger') }}

          <div class='form-group mb-2'>
            {{
              include('components/common/textbox.twig', {
                  key: 'CURRENT_PASSWORD',
                  type: 'password',
                  labelkey: 'CurrentPassword',
                  labelClass: 'fw-bold',
              }
            , false) }}
          </div>

          <div class='form-group mb-2'>
            {{
              include('components/common/textbox.twig', {
                  key: 'PASSWORD',
                  type: 'password',
                  labelkey: 'NewPassword',
                  labelClass: 'fw-bold',
              }
            , false) }}
          </div>

          <div class='form-group mb-3'>
            {{
              include('components/common/textbox.twig', {
                  key: 'PASSWORD_CONFIRM',
                  type: 'password',
                  value: '',
                  labelkey: 'PasswordConfirmation',
                  labelClass: 'fw-bold',
              }
            , false) }}
          </div>

          <div class='form-group d-grid'>
            {{
              include('components/common/button.twig', {
                  type: 'submit',
                  variant: 'primary',
                  name: constant('Actions::CHANGE_PASSWORD'),
                  value: translate('ChangePassword'),
                  key: 'ChangePassword',
              }
            , false) }}
          </div>

          {{ csrf_token() }}
        </form>
      {% endblock %}
      {% endembed %}

      {{ setfocus(key: 'CURRENT_PASSWORD') }}
    {% endif %}
  </div>
  {{ include('javascript-includes.twig') }}
{% endblock %}
