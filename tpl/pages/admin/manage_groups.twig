{% extends 'layouts/base.twig' %}
{% set DataTable = true %}

{% block content %}
<div id="page-manage-groups" class="admin-page">
    <div class="border-bottom mb-3 clearfix">
        <div class="dropdown admin-header-more float-end">
            <div class="btn-group btn-group-sm">
                <a href="#" class="add-group btn btn-primary" id="add-group">
                    <i class="bi bi-plus-circle-fill me-1"></i>
                    {{ translate('AddGroup') }}
                </a>
                {% if CanImportGroups or CanExportGroups %}
                <button class="btn btn-primary dropdown-toggle" type="button" id="moreResourceActions"
                    data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ translate('More') }}">
                    <i class="bi bi-three-dots"></i>
                </button>
                <ul class="dropdown-menu" aria-labelledby="moreResourceActions">
                    {% if CanImportGroups %}
                        <li>
                            <a href="#" class="import-groups dropdown-item" id="import-groups" data-bs-toggle="modal"
                                data-bs-target="#importGroupsDialog">
                                <i class="bi bi-download me-1"></i>{{ translate('Import') }}
                            </a>
                        </li>
                    {% endif %}
                    {% if CanExportGroups %}
                        <li>
                            <a href="{{ server.SCRIPT_NAME }}?dr=export" download class="export-groups dropdown-item"
                                id="export-groups" target="_blank" rel="noopener noreferrer">
                                <i class="bi bi-upload me-1"></i>{{ translate('Export') }}
                            </a>
                        </li>
                    {% endif %}
                </ul>
                {% endif %}
            </div>
        </div>

        <h1>{{ translate('ManageGroups') }}</h1>
    </div>

    {% embed 'components/common/card.twig' with {id: 'groupSearchPanel', class: 'mb-2'} %}
        {% block body %}
            <label for="groupSearch">{{ translate('FindGroup') }}</label>
            | {{ html_link(key: 'AllGroups', href: server.SCRIPT_NAME) }}
            <input type="text" id="groupSearch" class="form-control form-control-sm" size="40" />
        {% endblock %}
    {% endembed %}

    {% set tableId = 'groupList' %}
    {% embed 'components/common/card.twig' %}
        {% block body %}
            <table class="table table-striped table-hover border-top" id="{{ tableId }}">
                <thead>
                    <tr>
                        <th>{{ translate('GroupName') }}</th>
                        <th>{{ translate('GroupMembers') }}</th>
                        <th>{{ translate('Permissions') }}</th>
                        {% if CanChangeRoles %}
                            <th>{{ translate('GroupRoles') }}</th>
                        {% endif %}
                        <th>{{ translate('GroupAdmin') }}</th>
                        <th>{{ translate('GroupAutomaticallyAdd') }}</th>
                        <th class="action">{{ translate('Actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for group in groups %}
                        <tr data-group-id="{{ group.Id }}" data-group-default="{{ group.IsDefault }}">
                            <td class="dataGroupName">{{ group.Name }}</td>
                            <td><a href="#" class="update members link-primary">{{ translate('Manage') }}</a></td>
                            <td><a href="#" class="update permissions link-primary">{{ translate('Change') }}</a></td>
                            {% if CanChangeRoles %}
                                <td>
                                    {% if group.IsExtendedAdmin() %}
                                        <div class="btn-group btn-group-sm">
                                            <a href="#" class="update roles btn btn-outline-primary">{{ translate('Change') }}</a>
                                            <button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle"
                                                data-bs-toggle="dropdown" aria-label="{{ translate('More') }}">
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-right" role="menu">
                                                <li>
                                                    <h6 class="dropdown-header">{{ translate('Administration') }}</h6>
                                                </li>
                                                <li>
                                                    <hr class="dropdown-divider">
                                                </li>
                                                {% if group.IsGroupAdmin() %}
                                                    <li role="presentation">
                                                        <a role="menuitem" href="#"
                                                            class="update changeAdminGroups dropdown-item">{{ translate('Groups') }}</a>
                                                    </li>
                                                {% endif %}
                                                {% if group.IsResourceAdmin() %}
                                                    <li role="presentation">
                                                        <a role="menuitem" href="#"
                                                            class="update changeAdminResources dropdown-item">{{ translate('Resources') }}</a>
                                                    </li>
                                                {% endif %}
                                                {% if group.IsScheduleAdmin() %}
                                                    <li role="presentation">
                                                        <a role="menuitem" href="#"
                                                            class="update changeAdminSchedules dropdown-item">{{ translate('Schedules') }}</a>
                                                    </li>
                                                {% endif %}
                                            </ul>
                                        </div>
                                    {% else %}
                                        <a href="#" class="update roles link-primary">{{ translate('Add') }}</a>
                                    {% endif %}
                                </td>
                            {% endif %}
                            <td>{% if CanChangeRoles %}
                                    <a href="#"
                                        class="update groupAdmin link-primary">{{ group.AdminGroupName ?: chooseText }}</a>
                                {% else %}
                                    {{ group.AdminGroupName ?: chooseText }}
                                {% endif %}
                            </td>
                            <td>{% if group.IsDefault %}
                                    <i class="bi bi-check-circle text-success"></i>
                                {% else %}
                                    <span class="bi bi-x-circle text-danger"></span>
                                {% endif %}
                            </td>
                            <td class="action">
                                <a href="#" class="update rename link-primary" aria-label="{{ translate('Edit') }}">
                                    <span class="bi bi-pencil-square icon"></span></a> |
                                <a href="#" class="update delete" aria-label="{{ translate('Delete') }}">
                                    <span class="bi bi-trash3-fill text-danger icon remove"></span></a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

    <input type="hidden" id="activeId" />

    {% embed 'components/common/modal.twig' with {id: 'membersDialog', scrollable: true} %}
            {% block header %}<h5 class="modal-title" id="membersDialogLabel">{{ translate('GroupMembers') }}</h5>{% endblock %}
            {% block body %}
                    <div class="form-group mb-2">
                        <label class="fw-bold" for="userSearch">{{ translate('AddUser') }}: </label>
                        <a href="#" id="browseUsers" class="link-primary">{{ translate('Browse') }}</a>
                        <input type="text" id="userSearch" class="form-control form-control-sm" size="40" />
                    </div>
                    <h5><span id="totalUsers"></span> {{ translate('UsersInGroup') }}</h5>

                    <div id="groupUserList"></div>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary cancel"
                        data-bs-dismiss="modal">{{ translate('Done') }}</button>
                </div>
            {% endblock %}
        {% endembed %}

    {% embed 'components/common/modal.twig' with {id: 'allUsers', scrollable: true} %}
            {% block header %}<h5 class="modal-title" id="allUsersLabel">{{ translate('AllUsers') }}</h5>{% endblock %}
            {% block body %}
                <div id="allUsersList"></div>
            {% endblock %}
        {% endembed %}

    {% set tableIdFilter = 'permissionsDialogtable' %}
    {% embed 'components/common/modal.twig' with {id: 'permissionsDialog', scrollable: true} %}
            {% block header %}<h5 class="modal-title" id="permissionsDialogLabel">{{ translate('Permissions') }}</h5>{% endblock %}
            {% block body %}
                    <form id="permissionsForm" method="post">
                        <div class="d-flex align-items-center gap-1">
                            <a href="#" id="checkNoResources" class="link-primary">{{ translate('None') }}</a>
                            <div class="vr"></div>
                            <a href="#" id="checkAllResourcesFull" class="link-primary">{{ translate('FullAccess') }}</a>
                            <div class="vr"></div>
                            <a href="#" id="checkAllResourcesView" class="link-primary">{{ translate('ViewOnly') }}</a>
                        </div>

                        <table class="table table-striped table-hover overflow-auto w-100" id="{{ tableIdFilter }}">
                            <thead class="visually-hidden">
                                <tr>
                                    <th>{{ translate('Resource') }}</th>
                                </tr>
                            </thead>
                            {% for resource in resources %}
                                {% set rid = resource.GetResourceId() %}
                                <tr>
                                    <td>
                                        <div class="permissionRow form-group clearfix">
                                            <label for="permission_{{ rid }}"
                                                class="float-start">{{ resource.GetName() }}</label>
                                            <select class="form-select form-select-sm w-auto resourceId float-end"
                                                {{ formname(key: 'RESOURCE_ID', multi: true) }} id="permission_{{ rid }}">
                                                <option value="{{ rid }}_none" class="none">{{ translate('None') }}</option>
                                                <option value="{{ rid }}_0" class="full">{{ translate('FullAccess') }}</option>
                                                <option value="{{ rid }}_1" class="view">{{ translate('ViewOnly') }}</option>
                                            </select>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </table>
                    </form>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ update_button(submit: true, attributes: {form: 'permissionsForm'}) }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}

    <form id="removeUserForm" method="post">
        <input type="hidden" id="removeUserId" {{ formname(key: 'USER_ID') }} />
    </form>

    <form id="addUserForm" method="post">
        <input type="hidden" id="addUserId" {{ formname(key: 'USER_ID') }} />
    </form>

    <form id="addGroupForm" method="post">
        {% embed 'components/common/modal.twig' with {id: 'addGroupDialog'} %}
            {% block header %}<h5 class="modal-title" id="addGroupDialogLabel">{{ translate('AddGroup') }}</h5>{% endblock %}
            {% block body %}
                        <div id="addGroupResults" class="error" style="display:none;"></div>
                        <div class="form-group">
                            <label class="fw-bold" for="addGroupName">{{ translate('Name') }}<i
                                    class="bi bi-asterisk text-danger align-top" style="font-size: 0.5rem;"></i></label>
                            <input {{ formname(key: 'GROUP_NAME') }} type="text" id="addGroupName" required
                                class="form-control required has-feedback" />
                        </div>
                <div class="form-group mt-2">
                    {{ include('components/common/checkbox.twig', {id: 'addGroupIsDefault', name: constant('FormKeys::IS_DEFAULT'), labelkey: 'AutomaticallyAddToGroup', switchStyle: false}, false) }}
                </div>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ add_button() }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

    <form id="deleteGroupForm" method="post">
        {% embed 'components/common/modal.twig' with {id: 'deleteDialog'} %}
            {% block header %}<h5 class="modal-title" id="deleteDialogLabel">{{ translate('Delete') }}</h5>{% endblock %}
            {% block body %}
                        <div class="alert alert-warning">
                            <div>{{ translate('DeleteWarning') }}</div>
                            <div>{{ translate('DeleteGroupWarning') }}</div>
                        </div>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ delete_button() }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

    <form id="editGroupForm" method="post">
        {% embed 'components/common/modal.twig' with {id: 'editDialog'} %}
            {% block header %}<h5 class="modal-title" id="editDialogLabel">{{ translate('Update') }}</h5>{% endblock %}
            {% block body %}
                        <div class="form-group">
                            <label class="fw-bold" for="editGroupName">{{ translate('Name') }}<i
                                    class="bi bi-asterisk text-danger align-top form-control-feedback"
                                    style="font-size: 0.5rem;"></i></label>
                            <input type="text" id="editGroupName" class="form-control required has-feedback" required
                                {{ formname(key: 'GROUP_NAME') }} />
                        </div>
                <div class="form-group mt-2">
                    {{ include('components/common/checkbox.twig', {id: 'editGroupIsDefault', name: constant('FormKeys::IS_DEFAULT'), labelkey: 'AutomaticallyAddToGroup', switchStyle: false}, false) }}
                </div>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ update_button() }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

    {% if CanChangeRoles %}
    <form id="rolesForm" method="post">
        {% embed 'components/common/modal.twig' with {id: 'rolesDialog'} %}
            {% block header %}<h5 class="modal-title" id="rolesDialogLabel">{{ translate('WhatRolesApplyToThisGroup') }}</h5>{% endblock %}
            {% block body %}
                            {% for role in Roles %}
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="role{{ role.Id }}"
                                        {{ formname(key: 'ROLE_ID', multi: true) }} value="{{ role.Id }}" />
                                    <label class="form-check-label" for="role{{ role.Id }}">{{ role.Name }}</label>
                                </div>
                            {% endfor %}
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ update_button() }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

    {% embed 'components/common/modal.twig' with {id: 'resourceAdminDialog', class: 'adminDialog', scrollable: true} %}
            {% block header %}<h5 class="modal-title" id="resourceAdminDialogLabel">{{ translate('WhatCanThisGroupManage') }}</h5>{% endblock %}
            {% block body %}
                        <form id="resourceAdminForm" method="post">
                            <h4><span class="count"></span> {{ translate('Resources') }}</h4>

                            {% for resource in resources %}
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="resource{{ resource.GetId() }}"
                                        {{ formname(key: 'RESOURCE_ID', multi: true) }} value="{{ resource.GetId() }}" />
                                    <label class="form-check-label"
                                        for="resource{{ resource.GetId() }}">{{ resource.GetName() }}</label>
                                </div>
                            {% endfor %}
                        </form>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ update_button(submit: true, attributes: {form: 'resourceAdminForm'}) }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}

    <form id="groupAdminGroupsForm" method="post">
        {% embed 'components/common/modal.twig' with {id: 'groupAdminAllDialog', class: 'adminDialog', bodyClass: 'scrollable-modal-content'} %}
            {% block header %}<h5 class="modal-title" id="groupAdminAllDialogLabel">{{ translate('WhatCanThisGroupManage') }}</h5>{% endblock %}
            {% block body %}
                            <h4><span class="count"></span> {{ translate('Groups') }}</h4>

                            {% for group in groups %}
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="group{{ group.Id }}"
                                        {{ formname(key: 'GROUP_ID', multi: true) }} value="{{ group.Id }}" />
                            <label class="form-check-label" for="group{{ group.Id }}">{{ group.Name }}</label>
                        </div>
                        {% endfor %}
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ update_button() }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

    {% embed 'components/common/modal.twig' with {id: 'scheduleAdminDialog', class: 'adminDialog', scrollable: true} %}
            {% block header %}<h5 class="modal-title" id="scheduleAdminDialogLabel">{{ translate('WhatCanThisGroupManage') }}</h5>{% endblock %}
            {% block body %}
                    <form id="scheduleAdminForm" method="post">
                        <h4><span class="count"></span> {{ translate('Schedules') }}</h4>

                        {% for schedule in Schedules %}
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="schedule{{ schedule.GetId() }}"
                                {{ formname(key: 'SCHEDULE_ID', multi: true) }} value="{{ schedule.GetId() }}" />
                            <label class="form-check-label"
                                for="schedule{{ schedule.GetId() }}">{{ schedule.GetName() }}</label>
                        </div>
                        {% endfor %}
                    </form>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ update_button(submit: true, attributes: {form: 'scheduleAdminForm'}) }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    {% endif %}

    {% if CanChangeRoles %}
    <form id="groupAdminForm" method="post">
        {% embed 'components/common/modal.twig' with {id: 'groupAdminDialog'} %}
            {% block header %}<h5 class="modal-title" id="groupAdminDialogLabel">{{ translate('WhoCanManageThisGroup') }}</h5>{% endblock %}
            {% block body %}
                        <div class="form-group has-feedback">
                            <label for="groupAdmin"
                                class="off-screen fw-bold">{{ translate('WhoCanManageThisGroup') }}</label>
                            <select {{ formname(key: 'GROUP_ADMIN') }} class="form-select" id="groupAdmin">
                                <option value="">-- {{ translate('None') }} --</option>
                                {% for adminGroup in AdminGroups %}
                                <option value="{{ adminGroup.Id }}">{{ adminGroup.Name }}</option>
                                {% endfor %}
                            </select>
                        </div>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ update_button() }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>
    {% endif %}

    {% if CanImportGroups %}
    <form id="importGroupsForm" class="form" role="form" method="post" enctype="multipart/form-data" ajaxAction="{{ constant('ManageGroupsActions::Import') }}">
        {% embed 'components/common/modal.twig' with {id: 'importGroupsDialog'} %}
            {% block header %}<h5 class="modal-title" id="importGroupsDialogLabel">{{ translate('Import') }}</h5>{% endblock %}
            {% block body %}
                        <div id="importInstructions" class="alert alert-info">
                            <div class="note fst-italic">{{ translate('GroupsImportInstructions') }}</div>
                            <a href="{{ server.SCRIPT_NAME }}?dr=template" class="alert-link"
                                download="{{ server.SCRIPT_NAME }}?dr=template"
                                target="_blank">{{ translate('GetTemplate') }} <span class="bi bi-download"></span></a>
                        </div>
                        <div id="importGroupsResults" class="validationSummary alert alert-danger d-none">
                            <ul>
                                {{ async_validator('fileExtensionValidator', '') }}
                            </ul>
                        </div>
                        <div id="importErrors" class="alert alert-danger d-none"></div>
                        <div id="importResult" class="alert alert-success d-none">
                            <span>{{ translate('RowsImported') }}</span>

                            <span id="importCount" class="inline fw-bold">0</span>
                            <span>{{ translate('RowsSkipped') }}</span>

                            <span id="importSkipped" class="inline fw-bold">0</span>
                            <a class="alert-link" href="{{ server.SCRIPT_NAME }}">{{ translate('Done') }}</a>
                        </div>
                        <div class="">
                            <label class="visually-hidden" for="groupsImportFile">{{ translate('File') }}</label>
                            <input type="file" class="form-control" {{ formname(key: 'GROUP_IMPORT_FILE') }}
                                id="groupsImportFile" />
                            {{ include('components/common/checkbox.twig', {id: 'updateOnImport', name: constant('FormKeys::UPDATE_ON_IMPORT'), labelkey: 'UpdateGroupsOnImport', switchStyle: false, class: 'mt-1'}, false) }}
                        </div>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ add_button(key: 'Import') }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>
    {% endif %}

    {{ csrf_token() }}

    {{ include('javascript-includes.twig', {DataTable: true}, false) }}
    {{ datatable(tableId) }}
    {{ datatablefilter(tableIdFilter) }}
    {{ jsfile(src: 'ajax-helpers.js') }}
    {{ jsfile(src: 'autocomplete.js') }}
    {{ jsfile(src: 'admin/group.js') }}
    {{ vendor_js(src: 'jquery-form/3.09/jquery.form-3.09.min.js') }}

    <script type="text/javascript">
        $(document).ready(function() {

            var actions = {
                activate: '{{ constant('ManageGroupsActions::Activate')|raw }}',
                deactivate: '{{ constant('ManageGroupsActions::Deactivate')|raw }}',
                permissions: '{{ constant('ManageGroupsActions::Permissions')|raw }}',
                password: '{{ constant('ManageGroupsActions::Password')|raw }}',
                removeUser: '{{ constant('ManageGroupsActions::RemoveUser')|raw }}',
                addUser: '{{ constant('ManageGroupsActions::AddUser')|raw }}',
                addGroup: '{{ constant('ManageGroupsActions::AddGroup')|raw }}',
                updateGroup: '{{ constant('ManageGroupsActions::UpdateGroup')|raw }}',
                deleteGroup: '{{ constant('ManageGroupsActions::DeleteGroup')|raw }}',
                roles: '{{ constant('ManageGroupsActions::Roles')|raw }}',
                groupAdmin: '{{ constant('ManageGroupsActions::GroupAdmin')|raw }}',
                adminGroups: '{{ constant('ManageGroupsActions::AdminGroups')|raw }}',
                resourceGroups: '{{ constant('ManageGroupsActions::ResourceGroups')|raw }}',
                scheduleGroups: '{{ constant('ManageGroupsActions::ScheduleGroups')|raw }}',
                importGroups: '{{ constant('ManageGroupsActions::Import')|raw }}'
            };

            var dataRequests = {
                permissions: 'permissions',
                roles: 'roles',
                groupMembers: 'groupMembers',
                adminGroups: '{{ constant('ManageGroupsActions::AdminGroups')|raw }}',
                resourceGroups: '{{ constant('ManageGroupsActions::ResourceGroups')|raw }}',
                scheduleGroups: '{{ constant('ManageGroupsActions::ScheduleGroups')|raw }}'
            };

            var groupOptions = {
                userAutocompleteUrl: "../ajax/autocomplete.php?type={{ constant('AutoCompleteType::User')|raw }}",
                groupAutocompleteUrl: "../ajax/autocomplete.php?type={{ constant('AutoCompleteType::Group')|raw }}",
                groupsUrl: "{{ server.SCRIPT_NAME|raw }}",
                        permissionsUrl: '{{ server.SCRIPT_NAME|raw }}',
                        rolesUrl: '{{ server.SCRIPT_NAME|raw }}',
                        submitUrl: '{{ server.SCRIPT_NAME|raw }}',
                        saveRedirect: '{{ server.SCRIPT_NAME|raw }}',
                        selectGroupUrl: '{{ server.SCRIPT_NAME|raw }}?gid=',
                        actions: actions,
                        dataRequests: dataRequests
                    };

                    var groupManagement = new GroupManagement(groupOptions);
                    groupManagement.init();

                    //$('#add-group-panel').showHidePanel();
                });
            </script>
</div>
{% endblock %}
