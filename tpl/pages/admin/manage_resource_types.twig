{% extends 'layouts/base.twig' %}
{% set InlineEdit = true %}
{% set DataTable = true %}

{% block content %}

<div id="page-manage-resource-types" class="admin-page">

    {{ include('components/resource/menu.twig', {ResourcePageTitleKey: 'ManageResourceTypes'}) }}

    <div id="globalError" class="error" style="display:none"></div>

    <form id="addForm" ajaxAction="{{ constant('ManageResourceTypesActions::Add') }}" class="form-inline" role="form" method="post">
        <div class="accordion">
            {% embed 'components/common/accordion-item.twig' with {id: 'add-resource-type-panel', contentsId: 'collapse-add-contents', title: translate('AddResourceType'), open: true, bodyClass: 'add-contents'} %}
                {% block body %}
                        <div id="addResults" class="error d-none"></div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <label class="fw-bold" for="resourceTypeName">{{ translate('Name') }}<i
                                    class="bi bi-asterisk text-danger align-top" style="font-size: 0.5rem;"></i></label>
                            <div class="form-group">
                                <input type="text" class="form-control form-control-sm required has-feedback"
                                    maxlength="85" required {{ formname(key: 'RESOURCE_TYPE_NAME') }} id="resourceTypeName" />
                            </div>
                            <label class="fw-bold ms-3" for="resourceTypeDesc">{{ translate('Description') }}</label>
                            <div class="form-group">
                                <textarea class="form-control form-control-sm" rows="1"
                                    {{ formname(key: 'RESOURCE_TYPE_DESCRIPTION') }} id="resourceTypeDesc"></textarea>
                            </div>
                        </div>
                        <div class="accordion-footer border-top pt-3">
                            <button type="button" class="btn btn-primary btn-sm save create">
                                <i class="bi bi-check-circle"></i>
                                {{ translate('Create') }}
                            </button>
                            <button type="reset" class="btn btn-outline-secondary btn-sm">{{ translate('Reset') }}</button>
                            {{ indicator() }}
                        </div>
                {% endblock %}
            {% endembed %}
        </div>
    </form>

    {% embed 'components/common/card.twig' with {} %}
{% block body %}
            {% set tableId = 'resourceTypes' %}
            <table class="table table-striped table-hover border-top" id="{{ tableId }}">
                <thead>
                    <tr>
                        <th>{{ translate('Name') }}</th>
                        <th>{{ translate('Description') }}</th>
                        <th class="action">{{ translate('Actions') }}</th>
                        {% if AttributeList is defined and AttributeList|length > 0 %}
                            <th>{{ translate('More') }}</th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for type in ResourceTypes %}
                        {% set id = type.Id() %}
                        <tr>
                            <td>{{ type.Name() }}</td>
                            <td>{{ type.Description()|nl2br }}</td>
                            <td class="action">
                                <a href="#" class="update edit link-primary" aria-label="{{ translate('Edit') }}">
                                    <span class="bi bi-pencil-square icon"></span>
                                </a> |
                                <a href="#" class="update delete" aria-label="{{ translate('Delete') }}">
                                    <span class="bi bi-trash3-fill text-danger icon remove"></span>
                                </a>
                                <input type="hidden" class="id" value="{{ id }}" />
                            </td>
                            {% if AttributeList is defined and AttributeList|length > 0 %}
                                <td>
                                    {% for attribute in AttributeList %}
                                        {{ include('components/controls/attributes/inline-edit.twig', {url: server.SCRIPT_NAME ~ '?action=' ~ constant('ManageResourceTypesActions::ChangeAttribute'), id: id, attribute: attribute, value: type.GetAttributeValue(attribute.Id())}, false) }}
                                    {% endfor %}
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

{% endblock %}
{% endembed %}

    <input type="hidden" id="activeId" value="" />

    <form id="editForm" method="post" ajaxAction="{{ constant('ManageResourceTypesActions::Update') }}" class="was-validated">
{% embed 'components/common/modal.twig' with {id: 'editDialog'} %}
{% block header %}<h5 class="modal-title" id="editDialogLabel">{{ translate('Edit') }}</h5>{% endblock %}
{% block body %}
                        <div class="form-group has-feedback">
                            <label for="editName" class="fw-bold">{{ translate('Name') }}<i
                                    class="bi bi-asterisk text-danger align-top" style="font-size: 0.5rem;"></i></label>
                            <input type="text" id="editName" class="form-control form-control-sm required"
                                required="required" maxlength="85" {{ formname(key: 'RESOURCE_TYPE_NAME') }} />
                        </div>
                        <div class="form-group">
                            <label for="editDescription" class="fw-bold">{{ translate('Description') }}</label>
                            <textarea class="form-control form-control-sm" rows="2"
                                {{ formname(key: 'RESOURCE_TYPE_DESCRIPTION') }} id="editDescription"></textarea>
                        </div>

{% endblock %}
{% block footer %}
<div class="modal-footer">
                        {{ cancel_button() }}
                        {{ update_button() }}
                        {{ indicator() }}

</div>
{% endblock %}
{% endembed %}
</form>

    <form id="deleteForm" method="post" ajaxAction="{{ constant('ManageResourceTypesActions::Delete') }}">
{% embed 'components/common/modal.twig' with {id: 'deleteDialog'} %}
{% block header %}<h5 class="modal-title" id="deleteDialogLabel">{{ translate('Delete') }}</h5>{% endblock %}
{% block body %}
                        <div class="alert alert-warning">
                            <div>{{ translate('DeleteWarning') }}</div>
                        </div>

{% endblock %}
{% block footer %}
<div class="modal-footer">
                        {{ cancel_button() }}
                        {{ delete_button() }}
                        {{ indicator() }}

</div>
{% endblock %}
{% endembed %}
</form>

    {{ csrf_token() }}

    {{ include('javascript-includes.twig', {InlineEdit: true, DataTable: true}, false) }}
    {{ jsfile('ajax-helpers.js') }}
    {{ jsfile('admin/resource-types.js') }}
    {{ vendor_js('jquery-form/3.09/jquery.form-3.09.min.js') }}
    {{ datatable(tableId) }}
    <script type="text/javascript">
        function hidePopoversWhenClickAway() {
            $('body').on('click', function(e) {
                $('[rel="popover"]').each(function() {
                    if (!$(this).is(e.target) && $(this).has(e.target).length === 0 && $('.popover').has(e
                            .target).length === 0) {
                        $(this).popover('hide');
                    }
                });
            });
        }

        function setUpPopovers() {
            $('[rel="popover"]').popover({
                container: 'body',
                html: true,
                placement: 'top',
                content: function() {
                    var popoverId = $(this).data('popover-content');
                    return $(popoverId).html();
                }
            }).click(function(e) {
                e.preventDefault();
            }).on('show.bs.popover', function() {

            }).on('shown.bs.popover', function() {
                var trigger = $(this);
                var popover = trigger.data('bs.popover').tip();
                popover.find('.editable-cancel').click(function() {
                    trigger.popover('hide');
                });
            });
        }

        function setUpEditables() {
            $.fn.editable.defaults.mode = 'popup';
            $.fn.editable.defaults.toggle = 'manual';
            $.fn.editable.defaults.emptyclass = '';
            $.fn.editable.defaults.params = function(params) {
                params.CSRF_TOKEN = $('#csrf_token').val();
                return params;
            };

            var updateUrl = '{{ server.SCRIPT_NAME }}?action=';

            $('.inlineAttribute').editable({
                url: updateUrl + '{{ constant('ManageResourceTypesActions::ChangeAttribute') }}',
                emptytext: '-'
            });
        }

        $(document).ready(function() {
            setUpPopovers();
            hidePopoversWhenClickAway();
            setUpEditables();

            var opts = {
                submitUrl: '{{ server.SCRIPT_NAME }}',
                saveRedirect: '{{ server.SCRIPT_NAME }}'
            };

            var resourceTypes = new ResourceTypeManagement(opts);
            resourceTypes.init();

            {% for type in ResourceTypes %}
                resourceTypes.add({
                    id:{{ type.Id()|raw }},
                    name: "{{ type.Name()|escape_js }}",
                    description: "{{ type.Description()|escape_js }}"
                });
            {% endfor %}
        });

        //$('#add-resource-type-panel').showHidePanel();
    </script>
</div>

{% endblock %}
