{% extends 'layouts/base.twig' %}
{% set DataTable = true %}

{% block content %}
<div id="page-manage-accessories" class="admin-page">
    <h1 class="border-bottom mb-3">{{ translate('ManageAccessories') }}</h1>

    <form id="addForm" class="form-inline" role="form" method="post">
        <div class="accordion">
            {% set addTitle %}<i class="bi bi-plus-circle-fill me-1"></i>{{ translate('AddAccessory') }}{% endset %}
            {% embed 'components/common/accordion-item.twig' with {id: 'add-accessory-panel', contentsId: 'AddAccessoryContent', title: addTitle, bodyClass: 'add-contents', open: true} %}
                {% block body %}
                        <div class="row gy-2 mb-2">
                            <div class="col-5">
                                <div class="form-group d-flex align-items-center flex-wrap gap-3">
                                    <label class="fw-bold" for="accessoryName">{{ translate('AccessoryName') }}<i
                                            class="bi bi-asterisk text-danger align-top form-control-feedback"
                                            data-bv-icon-for="accessoryName" style="font-size: 0.5rem;"></i></label>
                                    <input {{ formname('ACCESSORY_NAME') }} type="text" autofocus id="accessoryName"
                                        required class="form-control form-control-sm has-feedback required w-auto" />

                                </div>
                            </div>
                            <div class="col-7">
                                <div class="form-group d-flex align-items-center flex-wrap gap-3">
                                    {{ include('components/common/checkbox.twig', {id: 'chkUnlimitedAdd', name: 'chkUnlimited', labelkey: 'Unlimited', checked: true, switchStyle: false, class: 'mb-0'}, false) }}

                                    <label class="fw-bold" for="addQuantity">{{ translate('QuantityAvailable') }}</label>
                                    <input type="number" id="addQuantity" class="form-control form-control-sm w-auto"
                                        min="0" disabled="disabled" {{ formname('ACCESSORY_QUANTITY_AVAILABLE') }} />
                                </div>
                            </div>
                        </div>
                        <div class="accordion-footer border-top pt-3">
                            {{ add_button() }}
                            {{ reset_button() }}
                        </div>
                {% endblock %}
            {% endembed %}
        </div>
    </form>

    {% set tableId = 'accessoriesTable' %}
    {% embed 'components/common/card.twig' %}
        {% block body %}
            <table class="table table-striped table-hover border-top" id="{{ tableId }}">
                <thead>
                    <tr>
                        <th>{{ translate('AccessoryName') }}</th>
                        <th>{{ translate('QuantityAvailable') }}</th>
                        <th>{{ translate('Resources') }}</th>
                        <th class="action">{{ translate('Actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for accessory in accessories %}
                        <tr data-accessory-id="{{ accessory.Id }}">
                            <td>{{ accessory.Name }}</td>
                            <td>{{ accessory.QuantityAvailable is not null ? accessory.QuantityAvailable : '&infin;'|raw }}</td>
                            <td>
                                <a href="#"
                                    class="update resources link-primary">{% if accessory.AssociatedResources == 0 %}{{ translate('All') }}{% else %}{{ accessory.AssociatedResources }}{% endif %}</a>
                            </td>
                            <td class="action d-flex align-items-center gap-2">
                                <a href="#" class="update edit link-primary">
                                    <span class="visually-hidden">{{ translate('Edit') }}</span>
                                    <span class="bi bi-pencil-square icon"></span></a>
                                <div class="vr"></div>
                                <a href="#" class="update delete link-primary">
                                    <span class="visually-hidden">{{ translate('Delete') }}</span>
                                    <span class="bi bi-trash3-fill text-danger icon remove"></span></a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

    <input type="hidden" id="activeId" />

    <form id="deleteForm" method="post">
        {% embed 'components/common/modal.twig' with {id: 'deleteDialog'} %}
            {% block header %}<h5 class="modal-title" id="deleteDialogLabel">{{ translate('Delete') }}</h5>{% endblock %}
            {% block body %}
                <div class="alert alert-warning">
                    <div>{{ translate('DeleteWarning') }}</div>
                    <div>{{ translate('DeleteAccessoryWarning') }}</div>
                </div>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ delete_button() }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

    <form id="editForm" method="post">
        {% embed 'components/common/modal.twig' with {id: 'editDialog'} %}
            {% block header %}<h5 class="modal-title" id="editDialogLabel">{{ translate('Edit') }}</h5>{% endblock %}
            {% block body %}
                <div class="form-group has-feedback mb-2">
                            <label class="fw-bold" for="editName">{{ translate('AccessoryName') }}<i
                                    class="bi bi-asterisk text-danger align-top form-control-feedback"
                                    data-bv-icon-for="editName" style="font-size: 0.5rem;"></i></label>
                            <input id="editName" type="text" class="form-control form-control-sm has-feedback required"
                                autofocus maxlength="85" {{ formname('ACCESSORY_NAME') }} />
                        </div>
                        <div class="form-group">
                            <label class="fw-bold" for="editQuantity">{{ translate('QuantityAvailable') }}</label>
                            <div class="d-flex align-items-center flex-wrap gap-3">
                                <input id="editQuantity" type="number" min="0"
                                    class="form-control form-control-sm w-auto" disabled="disabled"
                                    {{ formname('ACCESSORY_QUANTITY_AVAILABLE') }} />

                                {{ include('components/common/checkbox.twig', {id: 'chkUnlimitedEdit', name: 'chkUnlimited', labelkey: 'Unlimited', checked: true, switchStyle: false, class: 'mb-0'}, false) }}
                            </div>
                        </div>

            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ update_button() }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

    {% embed 'components/common/modal.twig' with {id: 'accessoryResourcesDialog', scrollable: true} %}
        {% block header %}<h5 class="modal-title" id="accessoryResourcesDialogLabel">{{ translate('Resources') }}</h5>{% endblock %}
        {% block body %}
            <form id="accessoryResourcesForm" role="form"
                        ajaxAction="{{ constant('ManageAccessoriesActions::ChangeAccessoryResource') }}" method="post">
                        <table class="table table-striped table-hover border-top">
                            <tbody>
                                {% for resource in resources %}
                                    {% set resourceId = resource.GetId() %}
                                    <tr>
                                        <td>
                                            <div resource-id="{{ resourceId }}">
                                                <div class="form-check">
                                                    <input id="accessoryResource{{ resourceId }}" type="checkbox"
                                                        data-type="resource-id" class="resourceCheckbox form-check-input"
                                                        name="{{ constant('FormKeys::ACCESSORY_RESOURCE') }}[{{ resource.GetId() }}]"
                                                        value="{{ resource.GetId() }}">
                                                    <label class="form-check-label" for="accessoryResource{{ resourceId }}">
                                                        {{ resource.GetName() }}
                                                    </label>
                                                </div>
                                                <div class="quantities mb-2 ms-4 collapse"
                                                    id="quantitiesaccessoryResource{{ resourceId }}">
                                                    <label class="fw-bold">{{ translate('MinimumQuantity') }}
                                                        <input type="number" min="0" data-type="min-quantity"
                                                            class="form-control form-control-sm" size="4" maxlength="4"
                                                            name="{{ constant('FormKeys::ACCESSORY_MIN_QUANTITY') }}[{{ resource.GetId() }}]">
                                                    </label>
                                                    <label class="fw-bold">{{ translate('MaximumQuantity') }}
                                                        <input type="number" min="0" data-type="max-quantity"
                                                            class="form-control form-control-sm" size="4" maxlength="4"
                                                            name="{{ constant('FormKeys::ACCESSORY_MAX_QUANTITY') }}[{{ resource.GetId() }}]">
                                                    </label>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </form>
        {% endblock %}
        {% block footer %}
            <div class="modal-footer">
                {{ cancel_button() }}
                {{ update_button(submit: true, attributes: {form: 'accessoryResourcesForm'}) }}
                {{ indicator() }}
            </div>
        {% endblock %}
    {% endembed %}

    {{ csrf_token() }}

    {{ include('javascript-includes.twig', {DataTable: true}, false) }}
    {{ datatable(tableId) }}
    {{ jsfile(src: 'ajax-helpers.js') }}
    {{ jsfile(src: 'admin/accessory.js') }}
    {{ vendor_js(src: 'jquery-form/3.09/jquery.form-3.09.min.js') }}

    <script type="text/javascript">
        $(document).ready(function() {

            var actions = {
                add: '{{ constant('ManageAccessoriesActions::Add')|raw }}', {# raw: JS string context #}
                edit: '{{ constant('ManageAccessoriesActions::Change')|raw }}', {# raw: JS string context #}
                deleteAccessory: '{{ constant('ManageAccessoriesActions::Delete')|raw }}' {# raw: JS string context #}
            };

            var accessoryOptions = {
                submitUrl: '{{ server.SCRIPT_NAME|raw }}', {# raw: JS string context #}
                saveRedirect: '{{ server.SCRIPT_NAME|raw }}', {# raw: JS string context #}
                actions: actions
            };

            var accessoryManagement = new AccessoryManagement(accessoryOptions);
            accessoryManagement.init();

            {% for accessory in accessories %}
                accessoryManagement.addAccessory('{{ accessory.Id|raw }}', '{{ accessory.Name|escape_js }}', '{{ accessory.QuantityAvailable|raw }}'); {# raw: JS string context #}
            {% endfor %}

            //$('#add-accessory-panel').showHidePanel();
        });
    </script>
    <script>
        $(document).ready(function() {
            $('.resourceCheckbox').on('change', function() {
                var collapseTarget = $('#quantitiesaccessoryResource' + $(this).val());

                if ($(this).is(':checked')) {
                    collapseTarget.collapse('show');
                } else {
                    collapseTarget.collapse('hide');
                }
            });
        });
    </script>
</div>
{% endblock %}
