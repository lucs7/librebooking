{% extends 'layouts/base.twig' %}

{% block content %}
<div id="page-data-cleanup" class="admin-page">

    {% embed 'components/common/card.twig' with {class: 'col-12 col-sm-8 mx-auto'} %}
        {% block body %}
            <h1 class="border-bottom mb-3">{{ translate('DataCleanup') }}</h1>

            <!-- Reservations Item -->
            <div class="cleanup-item p-3 border-bottom">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-7">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-calendar-check fs-5 link-primary mt-1 me-2"></i>
                            <div>
                                <div class="mb-0 d-block fs-6 fw-semibold">{{ translate('Reservations') }}
                                    <span class="badge bg-primary ms-2">{{ ReservationCount }}</span>
                                </div>
                                <div class="text-muted small">{{ translate('DeleteReservationsBefore') }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-5">
                        <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-2">
                            <div class="flex-grow-1">
                                <input type="text" id="reservationDeleteDate" class="form-control form-control-sm" />
                            </div>
                            <div style="min-width: 120px;">
                                {{ delete_button(class: 'btn-sm w-100', attributes: {id: 'deleteReservations'}) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Purge Deleted Reservations -->
            <div class="cleanup-item p-3 border-bottom">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-7">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-trash fs-5 text-warning mt-1 me-2"></i>
                            <div>
                                <div class="mb-0 d-block fs-6 fw-semibold">{{ translate('DeletedReservations') }}
                                    <span class="badge bg-warning text-dark ms-2">{{ DeletedReservationCount }}</span>
                                </div>
                                <div class="text-muted small">{{ translate('PermanentlyPurgeAllDeletedReservations') }}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-5 text-md-end">
                        <button id="purgeReservations" type="button" class="btn btn-sm btn-warning w-100">
                            <i class="bi bi-eraser me-1"></i>{{ translate('Purge') }}
                        </button>
                    </div>
                </div>
            </div>

            <!-- Blackouts Item -->
            <div class="cleanup-item p-3 border-bottom">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-7">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-clock-history fs-5 link-primary mt-1 me-2"></i>
                            <div>
                                <div class="mb-0 d-block fs-6 fw-semibold">{{ translate('ManageBlackouts') }}
                                    <span class="badge bg-primary ms-2">{{ BlackoutsCount }}</span>
                                </div>
                                <div class="text-muted small">{{ translate('DeleteBlackoutsBefore') }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-5">
                        <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-2">
                            <div class="flex-grow-1">
                                <input type="text" id="blackoutDeleteDate" class="form-control form-control-sm" />
                            </div>
                            <div style="min-width: 120px;">
                                {{ delete_button(class: 'btn-sm w-100', attributes: {id: 'deleteBlackouts'}) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Users Item -->
            <div class="cleanup-item p-3">
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-7">
                        <div class="d-flex align-items-start">
                            <i class="bi bi-person-x fs-5 link-primary mt-1 me-2"></i>
                            <div>
                                <div class="mb-0 d-block fs-6 fw-semibold">{{ translate('Users') }}
                                    <span class="badge bg-primary ms-2">{{ UserCount }}</span>
                                </div>
                                <div class="text-muted small">{{ translate('PermanentlyDeleteUsers') }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-md-5">
                        <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-2">
                            <div class="flex-grow-1">
                                <input type="text" id="userDeleteDate" class="form-control form-control-sm" />
                            </div>
                            <div style="min-width: 120px;">
                                {{ delete_button(class: 'btn-sm w-100', attributes: {id: 'deleteUsers'}) }}
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        {% endblock %}
    {% endembed %}

    <form id="deleteReservationsForm" method="post" ajaxAction="deleteReservations">
        {% embed 'components/common/modal.twig' with {id: 'deleteReservationsDialog'} %}
            {% block header %}<h5 class="modal-title" id="deleteReservationsDialogLabel">{{ translate('Delete') }}</h5>{% endblock %}
            {% block body %}
                        <div class="alert alert-warning">
                            <div>{{ translate('DeleteWarning') }}</div>
                            <div>
                                <strong><span id="deleteReservationCount"></span></strong>
                                {{ translate('ReservationsWillBeDeleted') }}
                            </div>
                            <input type="hidden" {{ formname('BEGIN_DATE') }} id="formDeleteReservationDate" />
                        </div>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ delete_button(submit: true) }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

    <form id="purgeReservationsForm" method="post" ajaxAction="purge">
        {% embed 'components/common/modal.twig' with {id: 'purgeReservationsDialog'} %}
            {% block header %}<h5 class="modal-title" id="purgeReservationsDialogLabel">{{ translate('Delete') }}</h5>{% endblock %}
            {% block body %}
                        <div class="alert alert-warning">
                            <div>{{ translate('DeleteWarning') }}</div>
                            <div>
                                <strong>{{ DeletedReservationCount }}</strong> {{ translate('ReservationsWillBePurged') }}
                            </div>
                        </div>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ delete_button(submit: true) }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

    <form id="deleteBlackoutsForm" method="post" ajaxAction="deleteBlackouts">
        {% embed 'components/common/modal.twig' with {id: 'deleteBlackoutDialog'} %}
            {% block header %}<h5 class="modal-title" id="deleteBlackoutDialogLabel">{{ translate('Delete') }}</h5>{% endblock %}
            {% block body %}
                        <div class="alert alert-warning">
                            <div>{{ translate('DeleteWarning') }}</div>
                            <div>
                                <strong><span id="deleteBlackoutCount"></span></strong>
                                {{ translate('BlackoutsWillBeDeleted') }}
                            </div>
                            <input type="hidden" {{ formname('BEGIN_DATE') }} id="formDeleteBlackoutDate" />
                        </div>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ delete_button(submit: true) }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

    <form id="deleteUsersForm" method="post" ajaxAction="deleteUsers">
        {% embed 'components/common/modal.twig' with {id: 'deleteUsersDialog'} %}
            {% block header %}<h5 class="modal-title" id="deleteUsersDialogLabel">{{ translate('Delete') }}</h5>{% endblock %}
            {% block body %}
                        <div class="alert alert-warning">
                            <div>{{ translate('DeleteWarning') }}</div>
                            <div>
                                <strong><span id="deleteUserCount"></span></strong> {{ translate('UsersWillBeDeleted') }}
                            </div>
                        </div>
                        <input type="hidden" {{ formname('BEGIN_DATE') }} id="formDeleteUserDate" />
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ delete_button(submit: true) }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

</div>

{{ include('javascript-includes.twig', {}, false) }}
{{ jsfile(src: 'ajax-helpers.js') }}

{{ control('DatePickerSetupControl', {ControlId: 'reservationDeleteDate', DefaultDate: DeleteDate}) }}
{{ control('DatePickerSetupControl', {ControlId: 'blackoutDeleteDate', DefaultDate: DeleteDate}) }}
{{ control('DatePickerSetupControl', {ControlId: 'userDeleteDate', DefaultDate: DeleteDate}) }}

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('deleteReservations').addEventListener('click', function(e) {
            $('#formDeleteReservationDate').val($('#reservationDeleteDate').val());
            ajaxGet('{{ server.SCRIPT_NAME|raw }}?dr=getReservationCount&date=' + $('#reservationDeleteDate').val(), null, function (data) {
            $('#deleteReservationCount').text(data.count);
            $('#deleteReservationsDialog').modal('show');
        })
    });

    document.getElementById('purgeReservations').addEventListener('click', function(e) {
        $('#purgeReservationsDialog').modal('show');
    });

    document.getElementById('deleteBlackouts').addEventListener('click', function(e) {
    $('#formDeleteBlackoutDate').val($('#blackoutDeleteDate').val());
    ajaxGet('{{ server.SCRIPT_NAME|raw }}?dr=getBlackoutCount&date=' + $('#blackoutDeleteDate').val(), null, function (data) {
    $('#deleteBlackoutCount').text(data.count);
    $('#deleteBlackoutDialog').modal('show');
    })
    });

    document.getElementById('deleteUsers').addEventListener('click', function(e) {
    $('#formDeleteUserDate').val($('#userDeleteDate').val());
    ajaxGet('{{ server.SCRIPT_NAME|raw }}?dr=getUserCount&date=' + $('#userDeleteDate').val(), null, function (data) {
    $('#deleteUserCount').text(data.count);
    $('#deleteUsersDialog').modal('show');
    })
    });

    ConfigureAsyncForm($('#deleteReservationsForm'));
    ConfigureAsyncForm($('#purgeReservationsForm'));
    ConfigureAsyncForm($('#deleteBlackoutsForm'));
    ConfigureAsyncForm($('#deleteUsersForm'));
    });
</script>
{% endblock %}
