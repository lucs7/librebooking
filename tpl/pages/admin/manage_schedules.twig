                                    {% endfor %}
                                </select>

                            </div>
                </div>

                        <input type="hidden" {{ formname('PEAK_DELETE') }} id="deletePeakTimes" value="" />
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ delete_button(class: 'pull-left', attributes: {id: 'deletePeakBtn'}) }}
                    {{ cancel_button() }}
                    {{ update_button() }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

