    <form id="resourcesPerReservationForm" method="post">
        {% embed 'components/common/modal.twig' with {id: 'resourcesPerReservationDialog'} %}
            {% block header %}<h5 class="modal-title" id="resourcesPerReservationDialogLabel">{{ translate('ScheduleResourcesPerReservation') }}</h5>{% endblock %}
            {% block body %}
                {{ include('components/common/checkbox.twig', {id: '<built-in function id>', name: constant('FormKeys::MAXIMUM_RESOURCES_PER_RESERVATION_UNLIMITED'), labelkey: 'Unlimited', switchStyle: false}, false) }}
                        <div class="form-group">
