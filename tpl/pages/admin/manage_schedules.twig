{% extends 'layouts/base.twig' %}
{% set InlineEdit = true %}
{% set Fullcalendar = true %}
{% set DataTable = true %}

{% block content %}
<div id="page-manage-schedules" class="admin-page">

    <div class="border-bottom mb-3 clearfix">
        <h1 class="float-start">{{ translate('ManageSchedules') }}</h1>
        <a href="#" class="add-link btn btn-sm btn-primary float-end" id="add-schedule">
            <span class="bi bi-plus-circle-fill me-1 icon add"></span>{{ translate('AddSchedule') }}
        </a>
    </div>

    {% set tableIdFilter = 'schedulesTable' %}
    {% embed 'components/common/card.twig' with {id: 'list-schedules-panel', bodyId: 'scheduleList'} %}
        {% block body %}
            <div class="accordion" id="scheduleAccordion">
                <table class="table table-borderless w-100" id="{{ tableIdFilter }}">
                    <thead class="d-none">
                        <tr>
                            <th>{{ translate('AllSchedules') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                            {% for schedule in Schedules %}
                                <tr>
                                    <td>
                                    {% set id = schedule.GetId() %}
                                    {% set dayOfWeek = schedule.GetWeekdayStart() %}
                                    {% set daysVisibleSpan %}<span
                                            class='propertyValue daysVisible inlineUpdate fw-bold text-decoration-underline pe-auto'
                                            data-type='number' data-pk='{{ id }}' data-name='{{ constant('FormKeys::SCHEDULE_DAYS_VISIBLE') }}'
                                        data-min='0'>{{ schedule.GetDaysVisible() }}</span>{% endset %}
                                    {% set dayNameSpan %}<span
                                            class='propertyValue dayName inlineUpdate fw-bold text-decoration-underline pe-auto'
                                            data-type='select' data-pk='{{ id }}' data-name='{{ constant('FormKeys::SCHEDULE_WEEKDAY_START') }}'
                                            data-value='{{ dayOfWeek }}'>{% if dayOfWeek == constant('Schedule::Today') %}{{ Today }}{% else %}{{ DayNames[dayOfWeek] }}{% endif %}</span>
                                    {% endset %}
                                        {% embed 'components/common/accordion-item.twig' with {id: 'schedule' ~ id, contentsId: 'panel' ~ id, title: schedule.GetName(), buttonClass: '', open: false} %}
                                            {% block body %}
                                                {# the embed's own `id` param shadows the schedule id inside the body #}
                                                {% set id = schedule.GetId() %}
                                                <div class="scheduleDetails row" data-schedule-id="{{ id }}">
                                                    <div class="col-12 col-sm-6">
                                                        <input type="hidden" class="id" value="{{ id }}" />
                                                        <input type="hidden" class="daysVisible" value="" />
                                                        <input type="hidden" class="dayOfWeek" value="{{ dayOfWeek }}" />

                                                        <div>
                                                            <span class="title scheduleName fw-bold" data-type="text"
                                                                data-pk="{{ id }}"
                                                                data-name="{{ constant('FormKeys::SCHEDULE_NAME') }}">{{ schedule.GetName() }}</span>
                                                            <a class="update renameButton link-primary" href="#"><span
                                                                    class="visually-hidden">{{ translate('Rename') }}</span><span
                                                                    class="bi bi-pencil-square"></span></a>
                                                        </div>

                                                        <div>
                                                            {{ translate('LayoutDescription', [dayNameSpan, daysVisibleSpan], 'fw-bold') }}</div>

                                                        <div>
                                                            {{ translate('ScheduleAdministrator') }}
                                                            <span class="propertyValue scheduleAdmin fw-bold"
                                                                data-type="select" data-pk="{{ id }}"
                                                                data-value="{{ schedule.GetAdminGroupId() }}"
                                                                data-name="{{ constant('FormKeys::SCHEDULE_ADMIN_GROUP_ID') }}">
                                                                {% set adminGroupId = schedule.GetAdminGroupId() %}
                                                                {% if adminGroupId is not null and GroupLookup[adminGroupId] is defined %}
                                                                    {{ GroupLookup[adminGroupId].Name|e }}
                                                                {% else %}
                                                                    {{ translate('None') }}
                                                                {% endif %}
                                                            </span>
                                                            {% if AdminGroups is defined and AdminGroups|length > 0 %}
                                                                <a class="link-primary update changeScheduleAdmin"><span
                                                                        class="visually-hidden">{{ translate('ScheduleAdministrator') }}</span><span
                                                                        class="bi bi-pencil-square"></span>
                                                                </a>
                                                            {% endif %}

                                                        </div>

                                                        <div class="availabilityPlaceHolder d-flex align-items-center">
                                                            <div class="availabilityContent">
                                                                {{ include('components/schedule/availability.twig', {schedule: schedule, timezone: Timezone}, false) }}
                                                            </div>

                                                            <a class="update changeAvailability link-primary ms-1" href="#">
                                                                <span
                                                                    class="visually-hidden">{{ translate('Availability') }}</span>
                                                                <span class="bi bi-pencil-square"></span>
                                                            </a>
                                                        </div>

                                                        <div class="maximumConcurrentContainer"
                                                            data-concurrent="{{ schedule.GetTotalConcurrentReservations() }}">
                                                            {% if schedule.EnforceConcurrentReservationMaximum() %}
                                                                {{ translate('ScheduleConcurrentMaximum', [schedule.GetTotalConcurrentReservations()]) }}
                                                            {% else %}
                                                                {{ translate('ScheduleConcurrentMaximumNone') }}
                                                            {% endif %}
                                                            <a href="#"
                                                                class="update changeScheduleConcurrentMaximum link-primary">
                                                                <span
                                                                    class="visually-hidden">{{ translate('ScheduleMaximumConcurrent') }}</span>
                                                                <span class="bi bi-pencil-square"></span>
                                                            </a>
                                                        </div>

                                                        <div class="resourcesPerReservationContainer"
                                                            data-maximum="{{ schedule.GetMaxResourcesPerReservation() }}">
                                                            {% if schedule.EnforceMaxResourcesPerReservation() %}
                                                                {{ translate('ScheduleResourcesPerReservationMaximum', [schedule.GetMaxResourcesPerReservation()]) }}
                                                            {% else %}
                                                                {{ translate('ScheduleResourcesPerReservationNone') }}
                                                            {% endif %}
                                                            <a href="#"
                                                                class="update changeResourcesPerReservation link-primary">
                                                                <span
                                                                    class="visually-hidden">{{ translate('ScheduleResourcesPerReservation') }}</span>
                                                                <span class="bi bi-pencil-square"></span>
                                                            </a>
                                                        </div>

                                                        <div>
                                                            {{ translate('DefaultStyle') }}
                                                            <span
                                                                class="propertyValue defaultScheduleStyle inlineUpdate fw-bold text-decoration-underline"
                                                                data-type="select" data-pk="{{ id }}"
                                                                data-name="{{ constant('FormKeys::SCHEDULE_DEFAULT_STYLE') }}"
                                                                data-value="{{ schedule.GetDefaultStyle().value }}">{{ StyleNames[schedule.GetDefaultStyle().value] }}</span>
                                                        </div>

                                                        {% if CreditsEnabled is defined and CreditsEnabled %}
                                                            <span>{{ translate('PeakTimes') }}</span>
                                                            <a class="update changePeakTimes link-primary" href="#">
                                                                <span class="visually-hidden">{{ translate('PeakTimes') }}</span>
                                                                <span class="bi bi-pencil-square"></span>
                                                            </a>
                                                            <div class="peakPlaceHolder">
                                                                {{ include('components/schedule/peak-times.twig', {Layout: Layouts[id], Months: Months, DayNames: DayNames}, false) }}
                                                            </div>
                                                        {% endif %}

                                                        <div>{{ translate('Resources') }}
                                                            <span class="propertyValue fw-bold">
                                                                {% if Resources[id] is defined %}
                                                                    {% for r in Resources[id] %}
                                                                        {{ r.GetName()|e }}{% if not loop.last %},
                                                                        {% endif %}
                                                                    {% endfor %}
                                                                {% else %}
                                                                    {{ translate('None') }}
                                                                {% endif %}
                                                            </span>
                                                        </div>

                                                        {% if schedule.GetIsCalendarSubscriptionAllowed() %}
                                                            <div>
                                                                <span>{{ translate('PublicId') }}</span>
                                                                <span
                                                                    class="propertyValue fw-bold">{{ schedule.GetPublicId() }}</span>
                                                            </div>
                                                        {% endif %}

                                                    </div>

                                                    <div class="layout col-12 col-sm-6">
                                                        <div>
                                                            {{ translate('ScheduleLayout', [schedule.GetTimezone()]) }}
                                                            <a class="update changeLayoutButton link-primary" href="#"
                                                                title="{{ translate('ChangeLayout') }}">
                                                                <span class="bi bi-pencil-square"
                                                                    data-layout-type="{{ Layouts[id].GetType() }}"></span>
                                                                <span
                                                                    class="visually-hidden">{{ translate('ChangeLayout') }}</span>
                                                            </a>
                                                        </div>
                                                        <input type="hidden" class="timezone"
                                                            value="{{ schedule.GetTimezone() }}" />

                                                        {% if Layouts[id].UsesDailyLayouts() %}
                                                            <input type="hidden" class="usesDailyLayouts" value="true" />
                                                            {{ translate('LayoutVariesByDay') }} - <a href="#layout{{ id }}"
                                                                class="link-primary" role="button"
                                                                data-bs-toggle="collapse">{{ translate('ShowHide') }}</a>
                                                            <div class="collapse" id="layout{{ id }}">
                                                                {% for day in range(0, 6) %}
                                                                    {{ DayNames[day] }}
                                                                    <div class="reservableSlots" id="reservableSlots_{{ day }}"
                                                                        ref="reservableEdit_{{ day }}">
                                                                        {% for period in Layouts[id].GetSlots(day) %}
                                                                            {% if period.IsReservable() %}
                                                                                {{ period.Start.Format('H:i') }} - {{ period.End.Format('H:i') }}
                                                                                {% if period.IsLabelled() %}
                                                                                    {{ period.Label }}
                                                                                {% endif %}
                                                                                {% if not loop.last %}, {% endif %}
                                                                            {% endif %}
                                                                        {% else %}
                                                                            {{ translate('None') }}
                                                                        {% endfor %}
                                                                    </div>
                                                                    <div class="blockedSlots" id="blockedSlots_{{ day }}"
                                                                        ref="blockedEdit_{{ day }}">
                                                                        {% for period in Layouts[id].GetSlots(day) %}
                                                                            {% if not period.IsReservable() %}
                                                                                {{ period.Start.Format('H:i') }} - {{ period.End.Format('H:i') }}
                                                                                {% if period.IsLabelled() %}
                                                                                    {{ period.Label }}
                                                                                {% endif %}
                                                                                {% if not loop.last %}, {% endif %}
                                                                            {% endif %}
                                                                        {% else %}
                                                                            {{ translate('None') }}
                                                                        {% endfor %}
                                                                    </div>
                                                                {% endfor %}
                                                            </div>
                                                            <div class="mt-4 fw-bold">
                                                                {{ translate('ThisScheduleUsesAStandardLayout') }}</div>
                                                            <div><a href="#" class="update switchLayout link-primary"
                                                                    data-switch-to="{{ constant('ScheduleLayout::Custom') }}">{{ translate('SwitchToACustomLayout') }}</a>
                                                            </div>
                                                        {% elseif Layouts[id].UsesCustomLayout() %}
                                                            <div class="mt-4 fw-bold">
                                                                {{ translate('ThisScheduleUsesACustomLayout') }}</div>
                                                            <div><a href="#" class="update switchLayout link-primary"
                                                                    data-switch-to="{{ constant('ScheduleLayout::Standard') }}">{{ translate('SwitchToAStandardLayout') }}</a>
                                                            </div>
                                                        {% else %}
                                                            <input type="hidden" class="usesDailyLayouts" value="false" />
                                                            {{ translate('ReservableTimeSlots') }}
                                                            <div class="reservableSlots" id="reservableSlots"
                                                                ref="reservableEdit">
                                                                {% for period in Layouts[id].GetSlots(null) %}
                                                                    {% if period.IsReservable() %}
                                                                        {{ period.Start.Format('H:i') }} - {{ period.End.Format('H:i') }}
                                                                        {% if period.IsLabelled() %}
                                                                            {{ period.Label }}
                                                                        {% endif %}
                                                                        {% if not loop.last %}, {% endif %}
                                                                    {% endif %}
                                                                {% else %}
                                                                    {{ translate('None') }}
                                                                {% endfor %}
                                                            </div>
                                                            {{ translate('BlockedTimeSlots') }}
                                                            <div class="blockedSlots" id="blockedSlots" ref="blockedEdit">
                                                                {% for period in Layouts[id].GetSlots(null) %}
                                                                    {% if not period.IsReservable() %}
                                                                        {{ period.Start.Format('H:i') }} - {{ period.End.Format('H:i') }}
                                                                        {% if period.IsLabelled() %}
                                                                            {{ period.Label }}
                                                                        {% endif %}
                                                                        {% if not loop.last %}, {% endif %}
                                                                    {% endif %}
                                                                {% else %}
                                                                    {{ translate('None') }}
                                                                {% endfor %}
                                                            </div>
                                                            <div class="mt-4 fw-bold">
                                                                {{ translate('ThisScheduleUsesAStandardLayout') }}</div>
                                                            <div><a href="#" class="update switchLayout link-primary"
                                                                    data-switch-to="{{ constant('ScheduleLayout::Custom') }}">{{ translate('SwitchToACustomLayout') }}</a>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                    <div class="actions col-12">
                                                        <div
                                                            class="alert alert-light  d-flex align-items-center gap-1 mb-0">
                                                            {% if schedule.GetIsDefault() %}
                                                                <span
                                                                    class="note fst-italic">{{ translate('ThisIsTheDefaultSchedule') }}</span>
                                                                <div class="vr"></div>
                                                                <span
                                                                    class="note fst-italic">{{ translate('DefaultScheduleCannotBeDeleted') }}</span>
                                                                <div class="vr"></div>
                                                            {% else %}
                                                                <a class="update makeDefaultButton link-primary"
                                                                    href="#">{{ translate('MakeDefault') }}</a>
                                                                <div class="vr"></div>
                                                                <a class="update deleteScheduleButton link-primary"
                                                                    href="#">{{ translate('Delete') }}</a>
                                                                <div class="vr"></div>
                                                            {% endif %}
                                                            {% if IcsEnabled is defined and IcsEnabled %}
                                                                {% if schedule.GetIsCalendarSubscriptionAllowed() %}
                                                                    <a class="update disableSubscription link-primary"
                                                                        href="#">{{ translate('TurnOffSubscription') }}</a>
                                                                    <div class="vr"></div>
                                                                {% else %}
                                                                    <a class="update enableSubscription link-primary"
                                                                        href="#">{{ translate('TurnOnSubscription') }}</a>
                                                                {% endif %}
                                                                {% if schedule.GetIsCalendarSubscriptionAllowed() %}
                                                                    {% set atomUrl = schedule.GetSubscriptionUrl().GetAtomUrl() %}
                                                                    {% set icalUrl = schedule.GetSubscriptionUrl().GetWebcalUrl() %}
                                                                    <a target="_blank" class="link-primary"
                                                                        title="{{ translate('UrlCopiedToClipboard') }}"
                                                                        onclick="copyUrlToClipboard('{{ atomUrl|escape_js }}'); return false;"
                                                                        href="{{ atomUrl|e }}"> <i
                                                                            class="bi bi-rss-fill link-primary me-1"></i>Atom</a>
                                                                    <div class="vr"></div>
                                                                    <a target="_blank" class="link-primary"
                                                                        title="{{ translate('UrlCopiedToClipboard') }}"
                                                                        onclick="copyUrlToClipboard('{{ icalUrl|escape_js }}'); return false;"
                                                                        href="{{ icalUrl|e }}">iCalendar</a>
                                                                {% endif %}
                                                            {% endif %}
                                                            {{ indicator('action-indicator') }}
                                                        </div>
                                                    </div>
                                                </div>
                                            {% endblock %}
                                        {% endembed %}
                                    </td>
                                </tr>
                            {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endblock %}
    {% endembed %}

    <form id="addScheduleForm" method="post">
        {% embed 'components/common/modal.twig' with {id: 'addDialog'} %}
            {% block header %}<h5 class="modal-title" id="addDialogLabel">{{ translate('AddSchedule') }}</h5>{% endblock %}
            {% block body %}
                        <div class="form-group">
                            <label class="fw-bold" for="addName">{{ translate('Name') }}<i
                                    class="bi bi-asterisk text-danger align-top" style="font-size: 0.5rem;"></i></label>
                            <input type="text" id="addName" class="form-control has-feedback required"
                                {{ formname('SCHEDULE_NAME') }} />
                        </div>
                        <div class="form-group">
                            <label class="fw-bold" for="addStartsOn">{{ translate('StartsOn') }}</label>
                            <select {{ formname('SCHEDULE_WEEKDAY_START') }} class="form-select" id="addStartsOn">
                                <option value="{{ constant('Schedule::Today') }}">{{ Today }}</option>
                                {% for dayIndex, dayName in DayNames %}
                                    <option value="{{ dayIndex }}">{{ dayName }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="fw-bold" for="addNumDaysVisible">{{ translate('NumberOfDaysVisible') }}</label>
                            <input type="number" min="1" max="100" class="form-control required" id="addNumDaysVisible"
                                value="7" {{ formname('SCHEDULE_DAYS_VISIBLE') }} />
                        </div>
                        <div class="form-group">
                            <label class="fw-bold" for="addSameLayoutAs">{{ translate('UseSameLayoutAs') }}</label>
                            {{ include('components/common/select.twig', {id: 'addSameLayoutAs', options: SourceSchedules, key: 'GetId', label: 'GetName', attrs: formname(key: 'SCHEDULE_ID')}, false) }}
                        </div>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ add_button(submit: true) }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

    <input type="hidden" id="activeId" value="" />

    <form id="deleteForm" method="post">
        {% embed 'components/common/modal.twig' with {id: 'deleteDialog'} %}
            {% block header %}<h5 class="modal-title" id="deleteDialogLabel">{{ translate('Delete') }}</h5>{% endblock %}
            {% block body %}
                        <div class="form-group">
                            <label class="fw-bold"
                                for="targetScheduleId">{{ translate('MoveResourcesAndReservations') }}</label>
                            <select id="targetScheduleId" {{ formname('SCHEDULE_ID') }} class="form-select required">
                                <option value="">-- {{ translate('Schedule') }} --</option>
                                {% for schedule in SourceSchedules %}
                                    <option value="{{ schedule.GetId() }}">{{ schedule.GetName() }}</option>
                                {% endfor %}
                            </select>
                        </div>
            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ delete_button() }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

    <form id="changeLayoutForm" method="post" role="form" class="form-inline">
        {% embed 'components/common/modal.twig' with {id: 'changeLayoutDialog', size: 'lg', scrollable: true, bodyClass: 'row gy-2'} %}
            {% block header %}<h5 class="modal-title" id="changeLayoutDialogLabel">{{ translate('ChangeLayout') }}</h5>{% endblock %}
            {% block body %}
                        <div class="col-12">
                            <div class="validationSummary alert alert-danger no-show">
                                <ul>{{ async_validator('layoutValidator', 'ValidLayoutRequired') }}</ul>
                            </div>
                        </div>
                <div class="col-12">
                    {{ include('components/common/checkbox.twig', {id: '<built-in function id>', name: constant('FormKeys::USING_SINGLE_LAYOUT'), labelkey: 'UseSameLayoutForAllDays', switchStyle: false}, false) }}
                </div>

                <div class="col-12" id="dailySlots">
                    <div role="tabpanel" id="tabs">
                        <ul class="nav nav-tabs mb-2" role="tablist">
                            {% for day in range(0, 6) %}
                                <li role="presentation" class="nav-item"><a href="#tabs-{{ day }}"
                                        class="nav-link{{ day == 0 ? ' active' : '' }} link-primary" aria-controls="tabs-{{ day }}" role="tab"
                                        data-bs-toggle="tab">{{ DayNames[day] }}</a></li>
                            {% endfor %}
                        </ul>
                        <div class="tab-content">
                            {% for day in range(0, 6) %}
                                <div role="tabpanel" class="tab-pane{{ day == 0 ? ' active' : '' }}" id="tabs-{{ day }}">
                                    <div class="row">
                                        <div class="col-6">
                                            <label class="fw-bold" for="reservableEdit_{{ day }}">{{ translate('ReservableTimeSlots') }}</label>
                                            <textarea class="reservableEdit form-control" id="reservableEdit_{{ day }}"
                                                name="{{ constant('FormKeys::SLOTS_RESERVABLE') }}_{{ day }}"></textarea>
                                        </div>
                                        <div class="col-6">
                                            <label class="fw-bold" for="blockedEdit_{{ day }}">{{ translate('BlockedTimeSlots') }}</label> <a href="#"
                                                class="autofillBlocked link-primary" title="{{ translate('Autofill') }}"><i
                                                    class="bi bi-magic"></i>
                                                {{ translate('Autofill') }}</a>
                                            <textarea class="blockedEdit form-control" id="blockedEdit_{{ day }}"
                                                name="{{ constant('FormKeys::SLOTS_BLOCKED') }}_{{ day }}"></textarea>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                        <div id="staticSlots" class="row">
                            <div class="col-6">
                                <label class="fw-bold"
                                    for="reservableEdit">{{ translate('ReservableTimeSlots') }}</label>
                                <textarea class="reservableEdit form-control" id="reservableEdit"
                                    name="{{ constant('FormKeys::SLOTS_RESERVABLE') }}"></textarea>
                            </div>
                            <div class="col-6">
                                <label class="fw-bold"
                                    for="blockedEdit">{{ translate('BlockedTimeSlots') }}</label> <a href="#"
                                    class="autofillBlocked link-primary" title="{{ translate('Autofill') }}"><i
                                        class="bi bi-magic"></i>
                                    {{ translate('Autofill') }}</a>
                                <textarea class="blockedEdit form-control" id="blockedEdit"
                                    name="{{ constant('FormKeys::SLOTS_BLOCKED') }}"></textarea>
                            </div>
                        </div>

                        <div class="slotTimezone col-12 d-flex align-items-center gap-1">
                            <label class="fw-bold" for="layoutTimezone">{{ translate('Timezone') }}</label>
                            <select {{ formname('TIMEZONE') }} id="layoutTimezone"
                                class="form-select form-select-sm w-auto">
                                {{ html_options(values: TimezoneValues, output: TimezoneOutput) }}
                            </select>
                        </div>

                        <div class="slotWizard col-12">
                            <div class="d-flex align-items-center flex-wrap gap-1">
                                {% set layoutConfig %}<input type='number' min='0' step='15' value='30' id='quickLayoutConfig' size='5'
                                    title='Minutes' class='form-control form-control-sm' />{% endset %}
                                {% set layoutStart %}<input type='text' value='08:00' id='quickLayoutStart' size='10' title='From time'
                                    class='form-control form-control-sm' maxlength='5' />{% endset %}
                                {% set layoutEnd %}<input type='text' value='18:00' id='quickLayoutEnd' size='10' title='End time'
                                    class='form-control form-control-sm' maxlength='5' />{% endset %}
                                {{ translate('QuickSlotCreation', [layoutConfig, layoutStart, layoutEnd]) }}
                                <a href="#" id="createQuickLayout" type="button"
                                    class="btn btn-primary btn-sm">{{ translate('Create') }}</a>
                            </div>
                        </div>
                        <div class="slotHelpText col-12">
                            <p>{{ translate('Format') }}: <span class="font-monospace">HH:MM - HH:MM
                                </span> {{ translate('OptionalLabel') }}</p>

                            <p>{{ translate('LayoutInstructions') }}</p>
                        </div>

            {% endblock %}
            {% block footer %}
                <div class="modal-footer">
                    {{ cancel_button() }}
                    {{ update_button() }}
                    {{ indicator() }}
                </div>
            {% endblock %}
        {% endembed %}
    </form>

    <form id="peakTimesForm" method="post">
        {% embed 'components/common/modal.twig' with {id: 'peakTimesDialog'} %}
            {% block header %}<h5 class="modal-title" id="peakTimesDialogLabel">{{ translate('PeakTimes') }}</h5>{% endblock %}
            {% block body %}
                <div class="form-group mb-2">
                    {{ include('components/common/checkbox.twig', {id: '<built-in function id>', name: constant('FormKeys::PEAK_ALL_DAY'), labelkey: 'AllDay', switchStyle: false}, false) }}
                            <div id="peakTimes" class="d-flex align-items-center flex-wrap gap-1">
                                <label class="fw-bold" for="peakStartTime">{{ translate('Between') }}</label>
                                <label for="peakStartTime" class="visually-hidden">Peak Begin Time</label>
                                <label for="peakEndTime" class="visually-hidden">Peak End Time</label>
                                <select {{ formname('PEAK_BEGIN_TIME') }} id="peakStartTime"
                                    class="form-select form-select-sm w-auto timepicker" data-format="{{ TimeFormat }}"
                                    data-step="30" data-default="{{ DefaultDate.format('H:i') }}">
                                </select>
                                <div class='mx-1'>-</div>
                                <select {{ formname('PEAK_END_TIME') }} id="peakEndTime"
                                    class="form-select form-select-sm w-auto timepicker" data-format="{{ TimeFormat }}"
                                    data-step="30" data-default="{{ DefaultDate.AddHours(9).format('H:i') }}">
                                </select>
                            </div>
                </div>
                <div class="form-group mb-2">
                    {{ include('components/common/checkbox.twig', {id: '<built-in function id>', name: constant('FormKeys::PEAK_EVERY_DAY'), labelkey: 'Everyday', switchStyle: false, checked: true}, false) }}
                    <div id="peakDayList" class="no-show">
                        <div class="btn-group-sm" data-bs-toggle="buttons">
                            {% for i, dayKey in ['SUNDAY', 'MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY', 'FRIDAY', 'SATURDAY'] %}
                                <input type="checkbox" class="btn-check" id="peakDay{{ i }}" {{ formname('REPEAT_' ~ dayKey) }} />
                                <label class="btn btn-outline-primary" for="peakDay{{ i }}">{{ DayNames[i] }}</label>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                <div class="form-group mb-2">
                    {{ include('components/common/checkbox.twig', {id: '<built-in function id>', name: constant('FormKeys::PEAK_ALL_YEAR'), labelkey: 'AllYear', switchStyle: false, checked: true}, false) }}
                            <div id="peakDateRange" class="no-show d-flex align-items-center gap-1">
                                <label for="peakBeginMonth" class="fw-bold">{{ translate('BeginDate') }}</label>

                                <select id="peakBeginMonth" class="form-select form-select-sm"
                                    {{ formname('PEAK_BEGIN_MONTH') }}>
                                    {% for i, month in Months %}
                                        <option value="{{ i + 1 }}">{{ month }}</option>
                                    {% endfor %}
                                </select>

                                <label for="peakBeginDay" class="no-show">Peak Begin Day</label>
                                <select id="peakBeginDay" class="form-select form-select-sm"
                                    {{ formname('PEAK_BEGIN_DAY') }}>
                                    {% for day in DayList %}
                                        <option value="{{ day }}">{{ day }}</option>
                                    {% endfor %}
                                </select>

                                <label for="peakEndMonth" class="fw-bold ms-2">{{ translate('EndDate') }}</label>
                                <select id="peakEndMonth" class="form-select form-select-sm"
                                    {{ formname('PEAK_END_MONTH') }}>
                                    {% for i, month in Months %}
                                        <option value="{{ i + 1 }}">{{ month }}</option>
                                    {% endfor %}
