            {% block header %}<h5 class="modal-title" id="concurrentMaximumDialogLabel">{{ translate('ScheduleMaximumConcurrent') }}</h5>{% endblock %}
            {% block body %}
                        <div class="alert alert-info">
                            {{ translate('ScheduleMaximumConcurrentNote') }}
                        </div>
                {{ include('components/common/checkbox.twig', {id: '<built-in function id>', name: constant('FormKeys::MAXIMUM_CONCURRENT_UNLIMITED'), labelkey: 'Unlimited', switchStyle: false}, false) }}
                        <div class="form-group">
