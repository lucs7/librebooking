<form id="deleteUserForm" method="post" ajaxAction="{{ constant('ManageUsersActions::DeleteUser') }}">
{% embed 'components/common/modal.twig' with {id: 'deleteDialog'} %}
    {% block header %}<h5 class="modal-title" id="deleteDialogLabel">{{ translate('Delete') }}</h5>{% endblock %}
    {% block body %}
<div class="alert alert-warning">
<div>{{ translate('DeleteWarning') }}</div>
<div>{{ translate('DeleteUserWarning') }}</div>
