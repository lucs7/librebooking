{% if CanEditUsers is defined and CanEditUsers %}
<form id="userForm" method="post" ajaxAction="{{ constant('ManageUsersActions::UpdateUser') }}">
{% embed 'components/common/modal.twig' with {id: 'userDialog', size: 'lg'} %}
