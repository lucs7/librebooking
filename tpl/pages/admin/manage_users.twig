<form id="deleteMultipleUserForm" method="post" ajaxAction="{{ constant('ManageUsersActions::DeleteMultipleUsers') }}">
{% embed 'components/common/modal.twig' with {id: 'deleteMultipleDialog'} %}
    {% block header %}<h5 class="modal-title" id="deleteMultipleDialogLabel">{{ translate('Delete') }} (<span id="deleteMultipleCount"></span>)</h5>{% endblock %}
    {% block body %}
