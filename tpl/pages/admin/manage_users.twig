{% embed 'components/common/modal.twig' with {id: 'groupsDialog', bodyClass: 'scrollable-modal-content'} %}
    {% block header %}<h5 class="modal-title" id="groupsDialogLabel">{{ translate('Groups') }}</h5>{% endblock %}
    {% block body %}
                    <div id="groupList" class="d-none">
                        {% for group in Groups %}
                            <div class="group-item d-flex align-items-center" groupId="{{ group.Id }}">
                                <a href="#"><span class="visually-hidden">{{ group.Name }}</span>&nbsp;</a>
                                <span>{{ group.Name }}</span>
                            </div>
                        {% endfor %}
                    </div>

                    <h6>{{ translate('GroupMembership') }} <span class="badge bg-primary" id="groupCount">0</span></h6>
                    <div id="addedGroups">
                    </div>

                    <h5>{{ translate('AvailableGroups') }}</h5>
                    <div id="removedGroups">
                    </div>

                    <form id="addGroupForm" method="post" ajaxAction="addUser">
                        <input type="hidden" id="addGroupId" {{ formname(key: 'GROUP_ID') }} />
                        <input type="hidden" id="addGroupUserId" {{ formname(key: 'USER_ID') }} />
                    </form>

                    <form id="removeGroupForm" method="post" ajaxAction="removeUser">
                        <input type="hidden" id="removeGroupId" {{ formname(key: 'GROUP_ID') }} />
                        <input type="hidden" id="removeGroupUserId" {{ formname(key: 'USER_ID') }} />
                    </form>
    {% endblock %}
{% endembed %}

<form id="colorForm" method="post" ajaxAction="{{ constant('ManageUsersActions::ChangeColor') }}">
{% embed 'components/common/modal.twig' with {id: 'colorDialog'} %}
    {% block header %}<h5 class="modal-title" id="colorDialogLabel">{{ translate('Color') }}</h5>{% endblock %}
    {% block body %}
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-paint-bucket"></i></span>
                            <label for="reservationColor" class="visually-hidden">Reservation Color</label>
                            <input type="color" {{ formname(key: 'RESERVATION_COLOR') }} id="reservationColor"
                                class="form-control form-control-color">
                        </div>
    {% endblock %}
    {% block footer %}
<div class="modal-footer">
{{ cancel_button() }}
{{ update_button() }}
{{ indicator() }}
</div>
    {% endblock %}
{% endembed %}
</form>

    {{ csrf_token() }}
    {{ include('javascript-includes.twig', {InlineEdit: true, DataTable: true}, false) }}
    {{ datatable(tableId is defined ? tableId : '') }}
    {{ datatablefilter(tableIdFilter is defined ? tableIdFilter : '') }}
    {{ jsfile(src: 'ajax-helpers.js') }}
    {{ jsfile(src: 'autocomplete.js') }}
    {{ jsfile(src: 'admin/user.js') }}
    {{ vendor_js(src: 'jquery-form/3.09/jquery.form-3.09.min.js') }}

    <script type="text/javascript">
        function setUpEditables() {
            $.fn.editable.defaults.mode = 'popup';
            $.fn.editable.defaults.toggle = 'manual';
            $.fn.editable.defaults.emptyclass = '';
            $.fn.editable.defaults.params = function(params) {
                params.CSRF_TOKEN = $('#csrf_token').val();
                return params;
            };

            var updateUrl = '{{ server.SCRIPT_NAME|raw }}?action=';{# raw: JS string context, matches Smarty #}
            $('.inlineAttribute').editable({
                url: updateUrl + '{{ constant('ManageUsersActions::ChangeAttribute') }}', emptytext: '-'
            });

            $('.changeCredits').editable({
                url: updateUrl + '{{ constant('ManageUsersActions::ChangeCredits') }}', emptytext: '-'
            });
        }

        $(document).ready(function() {
            var actions = {
                activate: '{{ constant('ManageUsersActions::Activate') }}', deactivate: '{{ constant('ManageUsersActions::Deactivate') }}'
            };

            var userOptions = {
                userAutocompleteUrl: "../ajax/autocomplete.php?type={{ constant('AutoCompleteType::MyUsers') }}",
                orgAutoCompleteUrl: "../ajax/autocomplete.php?type={{ constant('AutoCompleteType::Organization') }}",
                groupsUrl: '{{ server.SCRIPT_NAME|raw }}',{# raw: JS string context, matches Smarty #}
                groupManagementUrl: '{{ ManageGroupsUrl|raw }}',{# raw: JS string context, matches Smarty #}
                permissionsUrl: '{{ server.SCRIPT_NAME|raw }}',{# raw: JS string context, matches Smarty #}
                submitUrl: '{{ server.SCRIPT_NAME|raw }}',{# raw: JS string context, matches Smarty #}
                saveRedirect: '{{ server.SCRIPT_NAME|raw }}',{# raw: JS string context, matches Smarty #}
                selectUserUrl: '{{ server.SCRIPT_NAME|raw }}?uid=',{# raw: JS string context, matches Smarty #}
                filterUrl: '{{ server.SCRIPT_NAME|raw }}?{{ constant('QueryStringKeys::ACCOUNT_STATUS') }}=',{# raw: JS string context, matches Smarty #}
                actions: actions,
                manageReservationsUrl: '{{ ManageReservationsUrl|raw }}',{# raw: JS string context, matches Smarty #}
            };

            var userManagement = new UserManagement(userOptions);
            userManagement.init();

            {% for user in users %}
                var user = {
                    id: {{ user.Id }},
                    first: '{{ user.First|escape_js }}',
                    last: '{{ user.Last|escape_js }}',
                    isActive: '{{ user.IsActive() }}',
                    username: '{{ user.Username|escape_js }}',
                    email: '{{ user.Email|escape_js }}',
                    timezone: '{{ user.Timezone }}',
                    phone: '{{ user.Phone|escape_js }}',
                    organization: '{{ user.Organization|escape_js }}',
                    position: '{{ user.Position|escape_js }}',
                    reservationColor: '{{ user.ReservationColor|escape_js }}'
                };
                userManagement.addUser(user);
            {% endfor %}

            setUpEditables();
        });
    </script>
</div>
{% endblock %}
