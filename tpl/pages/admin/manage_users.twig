{% extends 'layouts/base.twig' %}
{% set InlineEdit = true %}
{% set DataTable = true %}

{% block content %}
<div id="page-manage-users" class="admin-page">

    <div class="border-bottom mb-3 clearfix">
        <div class="dropdown admin-header-more float-end">
            <div class="btn-group btn-group-sm">
                {% if CanCreateUsers is defined and CanCreateUsers %}
                    <a href="#" id="add-user" class="add-link add-user add-group btn btn-primary">
                        <i class="bi bi-plus-circle-fill me-1"></i>
                        {{ translate('AddUser') }}
                    </a>
                {% endif %}

                {% if (CanCreateUsers is defined and CanCreateUsers) or (CanExportUsers is defined and CanExportUsers) %}
                <button class="btn btn-primary btn-sm dropdown-toggle" type="button" id="moreUserActions"
                    data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{ translate('More') }}">
                    <i class="bi bi-three-dots"></i>
                </button>

                <ul class="dropdown-menu" aria-labelledby="moreUserActions">
                    {% if CanCreateUsers is defined and CanCreateUsers %}
                        <li>
                            <a href="#" id="invite-users" class="dropdown-item">
                                <i class="bi bi-send me-1"></i>
                                {{ translate('InviteUsers') }}
                            </a>
                        </li>
                        <li>
                            <a href="#" id="import-users" class="dropdown-item">
                                <i class="bi bi-download me-1"></i>
                                {{ translate('Import') }}
                            </a>
                        </li>
                    {% endif %}
                    {% if CanExportUsers is defined and CanExportUsers %}
                        <li>
                            <a href="{{ ExportUrl }}" download id="export-users" class="dropdown-item" target="_blank"
                                rel="noopener noreferrer">
                                <i class="bi bi-upload me-1"></i>
                                {{ translate('Export') }}
                            </a>
                        </li>
                    {% endif %}
                </ul>
                {% endif %}
            </div>
        </div>
        <h1 class="float-start">{{ translate('ManageUsers') }}</h1>
    </div>

    {% embed 'components/common/card.twig' with {class: 'mb-2'} %}
        {% block body %}
            <form id="filterForm" class="row" role="form">
                <div class="form-group col-sm-4">
                    <label class="fw-bold" for="userSearch"><i
                            class="bi bi-person-fill me-1"></i>{{ translate('FindUser') }}
                        | {{ html_link(key: 'AllUsers', href: server.SCRIPT_NAME) }}</label>
                    <input type="text" id="userSearch" class="form-control form-control-sm" />
                </div>
                <div class="form-group col-sm-2">
                    <label class="fw-bold" for="filterStatusId">{{ translate('Status') }}</label>
                    {{ include('components/common/select.twig', {id: 'filterStatusId', options: statusDescriptions, selected: FilterStatusId}, false) }}
                </div>
            </form>
        {% endblock %}
    {% endembed %}

    {% set tableId = 'userList' %}
    {% embed 'components/common/card.twig' %}
        {% block body %}
            <div class="table-responsive">
                <table class="table table-striped table-hover w-100" id="{{ tableId }}">
                    <thead>
                        <tr>
                            <th>{{ translate('Name') }}</th>
                            <th>{{ translate('Username') }}</th>
                            <th>{{ translate('Email') }}</th>
                            <th>{{ translate('Phone') }}</th>
                            <th>{{ translate('Organization') }}</th>
                            <th>{{ translate('Position') }}</th>
                            <th>{{ translate('Created') }}</th>
                            <th>{{ translate('LastLogin') }}</th>
                            <th class="action">{{ translate('Status') }}</th>
                            {% if CreditsEnabled is defined and CreditsEnabled %}
                                <th class="action">{{ translate('Credits') }}</th>
                            {% endif %}
                            {% if PerUserColors is defined and PerUserColors %}
                                <th class="action">{{ translate('Color') }}</th>
                            {% endif %}
                            <th>{{ translate('Actions') }}</th>
                            {% if CanDeleteUsers is defined and CanDeleteUsers %}
                                <th class="action-delete">
                                    <div class="form-check checkbox-single">
                                        <input class="form-check-input" type="checkbox" id="delete-all"
                                            aria-label="{{ translate('All') }}" title="{{ translate('All') }}" />
                                    </div>
                                    <a href="#" id="delete-selected" class="d-none" title="{{ translate('Delete') }}">
                                        <span class="visually-hidden">{{ translate('Delete') }}</span>
                                        <span class="bi bi-trash3-fill text-danger icon remove"></span>
                                    </a>
                                </th>
                            {% endif %}
                            {% set attributes = AttributeList %}
                            {% if attributes|default([])|length > 0 %}
                                <th>{{ translate('More') }}
                                </th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            {% set id = user.Id %}
                            <tr data-userId="{{ id }}">
                                <td>{{ fullname(first: user.First|default('')|html_entity_decode, last: user.Last|default('')|html_entity_decode, ignorePrivacy: true) }}
                                </td>
                                <td>{{ user.Username }}</td>
                                <td><a href="mailto:{{ user.Email }}" class="link-primary">{{ user.Email }}</a></td>
                                <td>{{ user.Phone }}</td>
                                <td>{{ user.Organization }}</td>
                                <td>{{ user.Position }}</td>
                                <td
                                    data-order="{{ format_date(user.DateCreated, format: 'Y-m-d H:i', timezone: Timezone) }}">
                                    {{ format_date(user.DateCreated, key: 'short_datetime', timezone: Timezone) }}</td>
                                <td data-order="{{ format_date(user.LastLogin, format: 'Y-m-d H:i', timezone: Timezone) }}">
                                    {{ format_date(user.LastLogin, key: 'short_datetime', timezone: Timezone) }}</td>
                                <td class="action">
                                    {% if CanChangeUserStatus is defined and CanChangeUserStatus %}
                                        <a href="#"
                                            class="update changeStatus link-primary">{{ statusDescriptions[user.StatusId] }}</a>
                                        {{ indicator(id: 'userStatusIndicator') }}
                                    {% else %}
                                        {{ statusDescriptions[user.StatusId] }}
                                    {% endif %}
                                </td>
                                {% if CreditsEnabled is defined and CreditsEnabled %}
                                    <td class="text-end">
                                        {% if CanChangeCredits is defined and CanChangeCredits %}
                                            <span class="propertyValue inlineUpdate changeCredits fw-bold text-decoration-underline"
                                                data-type="number" data-pk="{{ id }}" data-value="{{ user.CurrentCreditCount }}"
                                                data-name="{{ constant('FormKeys::CREDITS') }}">{{ user.CurrentCreditCount }}</span>
                                        {% else %}
                                            <span class="fw-bold">{{ user.CurrentCreditCount }}</span>
                                        {% endif %}
                                        <a href="credit_log.php?{{ constant('QueryStringKeys::USER_ID') }}={{ id }}"
                                            title="{{ translate('CreditHistory') }}" class="link-primary">
                                            <span class="no-color">{{ translate('CreditHistory') }}</span>
                                            <i class="bi bi-list-task"></i>
                                        </a>
                                    </td>
                                {% endif %}
                                {% if PerUserColors is defined and PerUserColors %}
                                    <td class="action">
                                        {% if CanChangeColors is defined and CanChangeColors %}
                                            <a href="#" class="update changeColor link-primary">{{ translate('Edit') }}</a>
                                            {% if user.ReservationColor is not empty %}
                                                <div class="user-color update changeColor rounded"
                                                    style="background-color:{{ user.ReservationColor|escape('html') }}">
                                                    &nbsp;
                                                </div>
                                            {% endif %}
                                        {% else %}
                                            {% if user.ReservationColor is not empty %}
                                                <div class="user-color rounded"
                                                    style="background-color:{{ user.ReservationColor|escape('html') }}">
                                                    &nbsp;
                                                </div>
                                            {% endif %}
                                        {% endif %}
                                    </td>
                                {% endif %}

                                <td width="100">
                                    <div class="btn-group btn-group-sm">
                                        {% if CanEditUsers is defined and CanEditUsers %}
                                            <button type="button" class="btn btn-primary update edit">
                                                <span class="visually-hidden">{{ translate('Update') }}</span>
                                                <i class="bi bi-pencil-square"></i></button>
                                        {% endif %}
                                        <button type="button" class="btn btn-primary dropdown-toggle"
                                            data-bs-toggle="dropdown">
                                            <span class="visually-hidden">{{ translate('More') }}</span>
                                        </button>
                                        <ul class="dropdown-menu" role="menu">
                                            {% if CanEditUsers is defined and CanEditUsers %}
                                                <li role="presentation"><a role="menuitem" href="#"
                                                        class="dropdown-item update edit">{{ translate('Edit') }}</a>
                                                </li>
                                            {% endif %}
                                            {% if CanChangePermissions is defined and CanChangePermissions %}
                                                <li role="presentation"><a role="menuitem" href="#"
                                                        class="dropdown-item update changePermissions">{{ translate('Permissions') }}</a>
                                                </li>
                                            {% endif %}
                                            <li role="presentation"><a role="menuitem" href="#"
                                                    class="dropdown-item update changeGroups">{{ translate('Groups') }}</a>
                                            </li>
                                            <li role="presentation"><a role="menuitem" href="#"
                                                    class="dropdown-item update viewReservations">{{ translate('Reservations') }}</a>
                                            </li>
                                            {% if CanChangePasswords is defined and CanChangePasswords %}
                                                <li role="presentation"><a role="menuitem" href="#"
                                                        class="dropdown-item update resetPassword">{{ translate('ChangePassword') }}</a>
                                                </li>
                                            {% endif %}

                                        </ul>
                                    </div>
                                    {% if CanDeleteUsers is defined and CanDeleteUsers %}
                                        |
                                        <span class="inline">
                                            <a href="#" class="update delete">
                                                <span class="visually-hidden">{{ translate('Delete') }}</span>
                                                <span class="bi bi-trash3-fill text-danger icon remove"></span>
                                            </a>
                                        </span>
                                    {% endif %}
                                </td>
                                {% if CanDeleteUsers is defined and CanDeleteUsers %}
                                    <td class="action-delete">
                                        <div class="form-check checkbox-single">
                                            <input {{ formname(key: 'USER_ID', multi: true) }} class="delete-multiple form-check-input"
                                                type="checkbox" id="delete{{ id }}" value="{{ id }}"
                                                aria-label="{{ translate('Delete') }}" title="{{ translate('Delete') }}" />
                                        </div>
                                    </td>
                                {% endif %}

                                {% if attributes|default([])|length > 0 %}
                                    <td class="customAttributes" userId="{{ id }}">
                                        {% set changeAttributeAction = constant('ManageUsersActions::ChangeAttribute') %}
                                        {% set attributeUrl = server.SCRIPT_NAME ~ '?action=' ~ changeAttributeAction %}
                                        {% for attribute in AttributeList %}
                                            {% if CanChangeAttributes is defined and CanChangeAttributes %}
                                                {{ include('components/controls/attributes/inline-edit.twig', {url: attributeUrl, id: id, attribute: attribute, value: user.GetAttributeValue(attribute.Id())}, false) }}
                                            {% elseif attribute.AppliesToEntity(id) %}
                                                <div class="mb-0 d-inline-block">
                                                    <label class="inline fw-bold">{{ attribute.Label() }}</label>
                                                    {{ user.GetAttributeValue(attribute.Id())|escape }}
                                                </div>
                                            {% endif %}
                                        {% endfor %}
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endblock %}
    {% endembed %}

{% if CanCreateUsers is defined and CanCreateUsers %}
<form id="addUserForm" class="form" role="form" method="post" ajaxAction="{{ constant('ManageUsersActions::AddUser') }}">
{% embed 'components/common/modal.twig' with {id: 'addUserDialog', size: 'lg', bodyClass: 'row gy-2'} %}
    {% block header %}<h5 class="modal-title" id="addUserDialogLabel">{{ translate('AddUser') }}</h5>{% endblock %}
    {% block body %}
                        <div class="col-12">
                            <div id="addUserResults" class="validationSummary alert alert-danger d-none">
                                <ul>
                                    {{ async_validator(id: 'addUserEmailformat', key: 'ValidEmailRequired') }}
                                    {{ async_validator(id: 'addUserUniqueemail', key: 'UniqueEmailRequired') }}
                                    {{ async_validator(id: 'addUserUsername', key: 'UniqueUsernameRequired') }}
                                    {{ async_validator(id: 'addAttributeValidator', key: '') }}
                                </ul>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-6">
                            <div class="form-group">
                                <label class="fw-bold" for="addUsername">{{ translate('Username') }}<i
                                        class="bi bi-asterisk text-danger align-top"
                                        style="font-size: 0.5rem;"></i></label>
                                <input type="text" {{ formname(key: 'USERNAME') }} class="required form-control has-feedback"
                                    required id="addUsername" />
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-6">
                            <div class="form-group">
                                <label class="fw-bold" for="addEmail">{{ translate('Email') }}<i
                                        class="bi bi-asterisk text-danger align-top"
                                        style="font-size: 0.5rem;"></i></label>
                                <input type="text" {{ formname(key: 'EMAIL') }} class="required form-control has-feedback"
                                    required id="addEmail" />
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-6">
                            <div class="form-group has-feedback">
                                <label class="fw-bold" for="addFname">{{ translate('FirstName') }}<i
                                        class="bi bi-asterisk text-danger align-top"
                                        style="font-size: 0.5rem;"></i></label>
                                <input type="text" {{ formname(key: 'FIRST_NAME') }}
                                    class="required form-control has-feedback" required id="addFname" />
                                <i class="glyphicon glyphicon-asterisk form-control-feedback"
                                    data-bv-icon-for="addFname"></i>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-6">
                            <div class="form-group has-feedback">
                                <label class="fw-bold" for="addLname">{{ translate('LastName') }}<i
                                        class="bi bi-asterisk text-danger align-top"
                                        style="font-size: 0.5rem;"></i></label>
                                <input type="text" {{ formname(key: 'LAST_NAME') }} class="required form-control has-feedback"
                                    required id="addLname" />
                                <i class="glyphicon glyphicon-asterisk form-control-feedback"
                                    data-bv-icon-for="addLname"></i>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-6">
                            <div class="form-group has-feedback">
                                <label class="fw-bold" for="addPassword">{{ translate('Password') }}<i
                                        class="bi bi-asterisk text-danger align-top"
                                        style="font-size: 0.5rem;"></i></label>
                                <input type="text" {{ formname(key: 'PASSWORD') }} class="required form-control has-feedback"
                                    required id="addPassword" />
                                <i class="glyphicon glyphicon-asterisk form-control-feedback"
                                    data-bv-icon-for="addPassword"></i>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-6">
                            <div class="form-group has-feedback">
                                <label class="fw-bold" for="addTimezone">{{ translate('Timezone') }}</label>
                                <select id="addTimezone" {{ formname(key: 'TIMEZONE') }} class="form-select">
                                    {{ html_options(values: Timezones, output: Timezones, selected: Timezone) }}
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-6">
                            <div class="form-group">
                                <label class="fw-bold" for="addPhone">{{ translate('Phone') }}</label>
                                <input type="text" {{ formname(key: 'PHONE') }} class="form-control" id="addPhone" />
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-6">
                            <div class="form-group">
                                <label class="fw-bold" for="addOrganization">{{ translate('Organization') }}</label>
                                <input type="text" {{ formname(key: 'ORGANIZATION') }} class="form-control"
                                    id="addOrganization" />
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-6">
                            <div class="form-group">
                                <label class="fw-bold" for="addPosition">{{ translate('Position') }}</label>
                                <input type="text" {{ formname(key: 'POSITION') }} class="form-control" id="addPosition" />
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-6">
                            <div class="form-group has-feedback">
                                <label class="fw-bold" for="addGroup">{{ translate('Group') }}</label>
                                <select id="addGroup" {{ formname(key: 'GROUP_ID') }} class="form-select">
                                    <option value="">{{ translate('None') }}</option>
                                    {{ object_html_options(options: Groups, label: 'Name', key: 'Id') }}
                                </select>
                            </div>
                        </div>
                        {% if AttributeList|default([])|length > 0 %}
                            <div class="col-12 col-sm-6">
                                {{ control('AttributeControl', {attribute: AttributeList[0]}) }}
                            </div>
                        {% else %}
                            <div class="col-sm-12 col-md-6">&nbsp;</div>
                        {% endif %}

                        {% if AttributeList|default([])|length > 1 %}
                            {% for i in 1..(AttributeList|default([])|length - 1) %}
                                <div class="col-12 col-sm-6">
                                    {{ control('AttributeControl', {attribute: AttributeList[i]}) }}
                                </div>
                            {% endfor %}
                        {% endif %}
                        <div class="clearfix"></div>
    {% endblock %}
    {% block footer %}
<div class="modal-footer">
{{ include('components/common/checkbox.twig', {id: 'sendAddEmail', name: constant('FormKeys::SEND_AS_EMAIL'), labelkey: 'NotifyUser', checked: true, switchStyle: false}, false) }}
{{ cancel_button() }}
{{ add_button() }}
{{ indicator() }}
</div>
    {% endblock %}
{% endembed %}
</form>

<form id="importUsersForm" class="form" role="form" method="post" enctype="multipart/form-data" ajaxAction="{{ constant('ManageUsersActions::ImportUsers') }}">
{% embed 'components/common/modal.twig' with {id: 'importUsersDialog', bodyClass: 'gap-3'} %}
    {% block header %}<h5 class="modal-title" id="importUsersDialogLabel">{{ translate('Import') }}</h5>{% endblock %}
    {% block body %}
                        <div id="importUserResults" class="validationSummary alert alert-danger d-none">
                            <ul>
                                {{ async_validator(id: 'fileExtensionValidator', key: '') }}
                            </ul>
                        </div>
                        <div id="importErrors" class="alert alert-danger d-none"></div>
                        <div id="importResult" class="alert alert-success d-none">
                            <span>{{ translate('RowsImported') }}</span>

                            <span id="importCount" class="inline fw-bold">0</span>
                            <span>{{ translate('RowsSkipped') }}</span>

                            <span id="importSkipped" class="inline fw-bold">0</span>
                            <a class="alert-link" href="{{ server.SCRIPT_NAME }}">{{ translate('Done') }}</a>
                        </div>
                        <div id="importInstructions" class="alert alert-info">
                            <div class="note fst-italic">{{ translate('UserImportInstructions') }}</div>
                            <a href="{{ server.SCRIPT_NAME }}?dr=template"
                                download="{{ server.SCRIPT_NAME }}?dr=template" class="alert-link"
                                target="_blank">{{ translate('GetTemplate') }}<span class="bi bi-download ms-1"></span></a>
                        </div>
                        <div>
                            <input class="form-control" type="file" {{ formname(key: 'USER_IMPORT_FILE') }} accept=".csv"
                                id="userImportFile" />
                            <label for="userImportFile" class="visually-hidden">User Import File</label>
                            {{ include('components/common/checkbox.twig', {id: 'updateOnImport', name: constant('FormKeys::UPDATE_ON_IMPORT'), labelkey: 'UpdateUsersOnImport', switchStyle: false, class: 'mt-2'}, false) }}
                        </div>
    {% endblock %}
    {% block footer %}
<div class="modal-footer">
{{ cancel_button() }}
{{ add_button(key: 'Import') }}
{{ indicator() }}
</div>
    {% endblock %}
{% endembed %}
</form>
{% endif %}

<input type="hidden" id="activeId" />

{% if CanChangePermissions is defined and CanChangePermissions %}
{% set tableIdFilter = 'permissionsFormFilter' %}
{% embed 'components/common/modal.twig' with {id: 'permissionsDialog', scrollable: true} %}
    {% block header %}<h5 class="modal-title" id="permissionsDialogLabel">{{ translate('Permissions') }}</h5>{% endblock %}
    {% block body %}
                    <form id="permissionsForm" method="post" ajaxAction="{{ constant('ManageUsersActions::Permissions') }}">
                        <div class="alert alert-warning">{{ translate('UserPermissionInfo') }}</div>
                        <a href="#" class="link-primary" id="checkNoResources">{{ translate('None') }}</a> |
                        <a href="#" class="link-primary" id="checkAllResourcesFull">{{ translate('FullAccess') }}</a> |
                        <a href="#" class="link-primary" id="checkAllResourcesView">{{ translate('ViewOnly') }}</a>
                        <table class="table table-striped table-hover w-100" id="{{ tableIdFilter }}">
                            <thead>
                                <tr>
                                    <th>{{ translate('Resource') }}</th>
                                </tr>
                            </thead>
                            {% for resource in resources %}
                                <tr>
                                    <td>
                                        {% set rid = resource.GetResourceId() %}
                                        <div class="permissionRow form-group clearfix">
                                            <label for="permission_{{ rid }}"
                                                class="float-start">{{ resource.GetName() }}</label>
                                            <select class="float-end form-select form-select-sm resourceId inline-block"
                                                style="width:auto;" {{ formname(key: 'RESOURCE_ID', multi: true) }}
                                                id="permission_{{ rid }}">
                                                <option value="{{ rid }}_none" class="none">{{ translate('None') }}</option>
                                                <option value="{{ rid }}_0" class="full">{{ translate('FullAccess') }}</option>
                                                <option value="{{ rid }}_1" class="view">{{ translate('ViewOnly') }}</option>
                                            </select>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </table>
                    </form>
    {% endblock %}
    {% block footer %}
<div class="modal-footer">
{{ cancel_button() }}
{{ update_button(submit: true, attributes: {form: 'permissionsForm'}) }}
{{ indicator() }}
</div>
    {% endblock %}
{% endembed %}
{% endif %}

{% if CanChangePasswords is defined and CanChangePasswords %}
