{% extends 'layouts/base.twig' %}

{% block content %}

<div id="page-manage-resource-status" class="admin-page">

    {{ include('components/resource/menu.twig', {ResourcePageTitleKey: 'ManageResourceStatus'}) }}

    <div id="globalError" class="error" style="display:none"></div>

    <div class="accordion">
        {% set titleAvailable %}<i class="bi bi-check-circle-fill text-success me-1"></i>{{ translate('Available') }}{% endset %}
        {% embed 'components/common/accordion-item.twig' with {id: 'resource-status-list-available', contentsId: 'panelAvailable', title: titleAvailable, class: 'mb-3 resource-status-list', open: true, bodyClass: 'add-contents'} %}
            {% block body %}
                        <a href="#" add-to="{{ constant('ResourceStatus::AVAILABLE') }}" class="add-link btn btn-primary btn-sm mb-2">
                            <i class="bi bi-plus-circle-fill me-1 icon add"></i>{{ translate('Add') }}
                        </a>
                        <div class="list-group">
                            {% for reason in StatusReasons[constant('ResourceStatus::AVAILABLE')] %}
                                {{ include('components/resource/status-reason.twig', {reason: reason}, false) }}
                            {% endfor %}
                        </div>
            {% endblock %}
        {% endembed %}

        {% set titleUnavailable %}<i class="bi bi-exclamation-circle-fill text-warning me-1"></i>{{ translate('Unavailable') }}{% endset %}
        {% embed 'components/common/accordion-item.twig' with {id: 'resource-status-list-unavailable', contentsId: 'panelUnavailable', title: titleUnavailable, class: 'mb-3 resource-status-list', open: true, bodyClass: 'add-contents'} %}
            {% block body %}
                        <a href="#" add-to="{{ constant('ResourceStatus::UNAVAILABLE') }}"
                            class="add-link btn btn-primary btn-sm mb-2"><i
                                class="bi bi-plus-circle-fill me-1 icon add"></i>{{ translate('Add') }}
                        </a>
                        <div class="list-group">
                            {% for reason in StatusReasons[constant('ResourceStatus::UNAVAILABLE')] %}
                                {{ include('components/resource/status-reason.twig', {reason: reason}, false) }}
                            {% endfor %}
                        </div>
            {% endblock %}
        {% endembed %}

        {% set titleHidden %}<i class="bi bi-x-circle-fill text-danger me-1"></i>{{ translate('Hidden') }}{% endset %}
        {% embed 'components/common/accordion-item.twig' with {id: 'resource-status-list-hidden', contentsId: 'panelHidden', title: titleHidden, class: 'mb-3 resource-status-list', open: true, bodyClass: 'add-contents'} %}
            {% block body %}
                        <a href="#" add-to="{{ constant('ResourceStatus::HIDDEN') }}" class="add-link btn btn-primary btn-sm mb-2">
                            <i class="bi bi-plus-circle-fill me-1 icon add"></i>{{ translate('Add') }}
                        </a>
                        <div class="list-group">
                            {% for reason in StatusReasons[constant('ResourceStatus::HIDDEN')] %}
                                {{ include('components/resource/status-reason.twig', {reason: reason}, false) }}
                            {% endfor %}
                        </div>
            {% endblock %}
        {% endembed %}
    </div>

    <input type="hidden" id="activeId" value="" />

    <form id="addForm" method="post" ajaxAction="{{ constant('ManageResourceStatusActions::Add') }}" class="was-validated">
{% embed 'components/common/modal.twig' with {id: 'addDialog'} %}
{% block header %}<h5 class="modal-title" id="addDialogLabel">{{ translate('Add') }}</h5>{% endblock %}
{% block body %}
                        <div class="form-group has-feedback">
                            <label class="fw-bold" for="add-reason-description">{{ translate('Name') }}</label><br />
                            <input type="text" class="form-control form-control-sm required" required
                                id="add-reason-description" {{ formname(key: 'RESOURCE_STATUS_REASON') }} />
                            <input type="hidden" id="add-reason-status" {{ formname(key: 'RESOURCE_STATUS_ID') }} />
                        </div>

{% endblock %}
{% block footer %}
<div class="modal-footer">
                        {{ cancel_button() }}
                        {{ add_button() }}
                        {{ indicator() }}

</div>
{% endblock %}
{% endembed %}
</form>

    <form id="editForm" method="post" ajaxAction="{{ constant('ManageResourceStatusActions::Update') }}" class="was-validated">
{% embed 'components/common/modal.twig' with {id: 'editDialog'} %}
{% block header %}<h5 class="modal-title" id="editDialogLabel">{{ translate('Edit') }}</h5>{% endblock %}
{% block body %}
                        <div class="form-group has-feedback">
                            <label class="fw-bold" for="edit-reason-description">{{ translate('Name') }}</label>
                            <input type="text" class="form-control required" required id="edit-reason-description"
                                {{ formname(key: 'RESOURCE_STATUS_REASON') }} />
                            <input type="hidden" id="add-reason-status" {{ formname(key: 'RESOURCE_STATUS_ID') }} />
                        </div>

{% endblock %}
{% block footer %}
<div class="modal-footer">
                        {{ cancel_button() }}
                        {{ update_button() }}
                        {{ indicator() }}

</div>
{% endblock %}
{% endembed %}
</form>

    <form id="deleteForm" method="post" ajaxAction="{{ constant('ManageResourceStatusActions::Delete') }}">
{% embed 'components/common/modal.twig' with {id: 'deleteDialog'} %}
{% block header %}<h5 class="modal-title" id="deleteDialogLabel">{{ translate('Delete') }}</h5>{% endblock %}
{% block body %}
                        <div class="alert alert-warning">
                            <div>{{ translate('DeleteWarning') }}</div>
                        </div>

{% endblock %}
{% block footer %}
<div class="modal-footer">
                        {{ cancel_button() }}
                        {{ delete_button() }}
                        {{ indicator() }}

</div>
{% endblock %}
{% endembed %}
</form>

    {{ csrf_token() }}
    {{ include('javascript-includes.twig', {}, false) }}
    {{ jsfile('ajax-helpers.js') }}
    {{ jsfile('admin/resource-status.js') }}
    {{ vendor_js('jquery-form/3.09/jquery.form-3.09.min.js') }}

    <script type="text/javascript">
        $(document).ready(function() {
            var opts = {
                submitUrl: '{{ server.SCRIPT_NAME }}',
                saveRedirect: '{{ server.SCRIPT_NAME }}'
            };

            var resourceStatus = new ResourceStatusManagement(opts);
            resourceStatus.init();

            /*$('#resource-status-list-available').showHidePanel();
            $('#resource-status-list-unavailable').showHidePanel();
            $('#resource-status-list-hidden').showHidePanel();*/
        })
    </script>

</div>

{% endblock %}
