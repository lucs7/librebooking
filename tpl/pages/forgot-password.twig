{% extends 'layouts/base.twig' %}

{% block content %}
  <div id='page-forgot-pwd' class='col-sm-8 col-12 mx-auto mt-5'>
    {% if Enabled is defined and Enabled %}
      {% embed 'components/common/card.twig' with {id: 'forgot-pwd-card'} %}
      {% block header %}
        <h1 class='text-center m-0'>{{ translate('ForgotPassword') }}</h1>
      {% endblock %}
      {% block body %}
        <form class='forgot' method='post' action='{{ server.SCRIPT_NAME }}'>
          <p class='forgot'>{{ translate('YouWillBeEmailedANewPassword') }}</p>
          <!-- Alert goes here for a nice width same as form -->
          {% if ShowResetEmailSent is defined and ShowResetEmailSent %}
            <div class='alert alert-success alert-dismissible fade show' role='alert'>
              {{ translate('ForgotPasswordEmailSent') -}}
              <br>
              <a class='link-success' href="{{ Path }}{{ constant('Pages::LOGIN') }}">{{ translate('LogIn') }}</a>
              <button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Close'></button>
            </div>
          {% endif %}
          <p>
            {{
              include('components/common/textbox.twig', {
                key: 'EMAIL',
                type: 'email',
                required: true,
                class: 'input',
                labelkey: 'EmailAddress',
                placeholderkey: 'Email',
                attributes: {size: '20', tabindex: '10'},
              }
            , false) }}
          </p>
          <p class='resetpassword'>
            {{
              include('components/common/button.twig', {
                type: 'submit',
                variant: 'primary',
                key: 'ChangePassword',
                name: constant('Actions::RESET'),
                value: constant('Actions::RESET'),
              }
            , false) }}
          </p>
        </form>
      {% endblock %}
      {% endembed %}

      {{ setfocus(key: 'EMAIL') }}
    {% else %}
      <h2 class='alert alert-danger alert-dismissible fade show text-center error'>Disabled</h2>
    {% endif %}
  </div>
{% endblock %}
