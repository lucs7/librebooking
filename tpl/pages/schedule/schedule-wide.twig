{# schedule-wide.tpl #}
{% extends 'pages/schedule/schedule.twig' %}

{% block reservations %}
{% import 'components/schedule/slot_macros.twig' as slot %}

{% set TodaysDate = now() %}
{% set firstPeriods = DailyLayout.GetPeriods(BoundDates[0], false) %}
{% set lastIndex = BoundDates|length - 1 %}
{% set lastPeriods = DailyLayout.GetPeriods(BoundDates[lastIndex], false) %}
{% set min = firstPeriods[0].BeginDate().TimeStamp() %}
{% set max = lastPeriods[lastPeriods|length - 1].EndDate().TimeStamp() %}
<table class="reservations" border="1" cellpadding="0" style="width:auto;" data-min="{{ min }}" data-max="{{ max }}">
    <thead>
    <tr>
        <td rowspan="2">&nbsp;</td>
        {% for date in BoundDates %}
            {% set datePeriods = DailyLayout.GetPeriods(date, false) %}
            {% if datePeriods|default([])|length != 0 %}{# dont show if there are no slots #}
                {% set class = '' %}
                {% if date.DateEquals(TodaysDate) %}
                    {% set class = 'today' %}
                {% endif %}
                <td class="resdate {{ class }}"
                    colspan="{{ datePeriods|default([])|length }}">{{ formatdate(date, null, null, 'schedule_daily') }}</td>
            {% endif %}
        {% endfor %}
    </tr>
    <tr>
        {% for date in BoundDates %}
            {% set datePeriods = DailyLayout.GetPeriods(date, false) %}
            {% for period in datePeriods %}
                <td class="reslabel" colspan="{{ period.Span() }}">{{ period.Label(date) }}</td>
            {% endfor %}
        {% endfor %}
    </tr>
    </thead>
    <tbody>

    {% for resource in Resources %}
        {% set resourceId = resource.Id %}
        {% set href = CreateReservationPage ~ '?rid=' ~ resource.Id ~ '&sid=' ~ ScheduleId %}
        <tr class="slots">
            <td class="resourcename"
                {% if resource.HasColor() %}style="background-color:{{ resource.GetColor() }} !important"{% endif %}>
                {% if resource.CanAccess %}
                    <a href="{{ href|raw }}" resourceId="{{ resource.Id }}"
                       class="resourceNameSelector"
                       {% if resource.HasColor() %}style="color:{{ resource.GetTextColor() }} !important"{% endif %}>{{ resource.Name }}</a>
                {% else %}
                    <span resourceId="{{ resourceId }}" class="resourceNameSelector"
                          {% if resource.HasColor() %}style="color:{{ resource.GetTextColor() }} !important"{% endif %}>{{ resource.Name }}</span>
                {% endif %}
            </td>
            {% for date in BoundDates %}
                {% set dateSlots = DailyLayout.GetPeriods(date, false) %}
                {% for Slot in dateSlots %}
                    {% set slotHref = CreateReservationPage ~ '?rid=' ~ resource.Id ~ '&sid=' ~ ScheduleId ~ '&rd=' ~ formatdate(date, null, null, 'url') %}
                    {% set slotRef = Slot.BeginDate().Format('YmdHis') ~ resourceId %}
                    {{ slot.dispatch(DisplaySlotFactory.GetFunction(Slot, resource.CanAccess), Slot, slotHref|raw, slotRef, resourceId) }}
                {% endfor %}
            {% endfor %}
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}

{% block scripts_before %}

{% endblock %}
