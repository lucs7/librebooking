{% include 'globalheader.twig' with {'DataTable': true} %}

<div id="page-admin-credit-log" class="admin-page">
    <h1 class="border-bottom mb-3">{{ translate('CreditHistory') }} - {{ UserName }}</h1>

    {% if ShowError is defined and ShowError %}
        <div class="alert alert-danger">
            {{ translate('UserNotFound') }}
        </div>
    {% else %}
        {% set tableId = 'credit-log-list' %}
        <table class="table table-striped table-hover border-top w-100" id="{{ tableId }}">
            <thead>
                <tr>
                    <th>{{ translate('Date') }}</th>
                    <th>{{ translate('Note') }}</th>
                    <th>{{ translate('CreditsBefore') }}</th>
                    <th>{{ translate('CreditsAfter') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for log in CreditLog %}
                    <tr>
                        <td>{{ formatdate(log.Date, timezone=Timezone, key='general_datetime') }}</td>
                        <td>{{ log.Note }}</td>
                        <td>{{ log.OriginalCreditCount }}</td>
                        <td>{{ log.CreditCount }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

    {% endif %}

</div>

{% include 'javascript-includes.twig' with {'DataTable': true} %}
{{ datatable(tableId is defined ? tableId : '') }}

{% include 'globalfooter.twig' %}