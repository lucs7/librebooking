<noscript>
  <div class='alert alert-warning text-center m-2' role='alert'>
    {{ translate('JavascriptRequired') }}
  </div>
</noscript>

{# Alert everyone if `script.url` is unset or missing the required `/Web` suffix, as either will cause issues. #}
{% if ScriptUrl is not defined or ScriptUrl == '' %}
  <div id='script-url-warning' class='alert alert-danger text-center m-2' role='alert'>
    {{ translate('ScriptUrlNotConfigured') }}
  </div>
{% elseif ScriptUrlMissingWebSuffix is not empty %}
  <div id='script-url-web-suffix-warning' class='alert alert-danger text-center m-2' role='alert'>
    {{ translate('ScriptUrlMissingWebSuffix') }}
  </div>
{% endif %}
<header class='d-flex align-items-center gap-2 m-2'>
  <a class='navbar-brand' href='{{ HomeUrl }}'>
    <img src='{{ Path }}{{ LogoUrl }}?{{ Version }}' alt='{{ Title }}' class='logo'>
  </a>
  <div class='border-start ps-2 d-flex flex-column'>
    {% if CompanyName != '' %}
      <h5 class='mb-0'>
        <a class='link-primary' href='{{ CompanyUrl }}'>{{ CompanyName }}</a>
      </h5>
    {% endif %}
    <h5 class='mb-0'>
      <a class='link-primary' href='{{ HomeUrl }}'>{{ AppTitle }}</a>
    </h5>
  </div>
</header>
