Foglalás részletei:
<br/>
<br/>

Kezdés: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
Befejezés: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>
{% if ResourceNames|default([])|length > 1 %}
    Elemel:
    <br/>
    {% for resourceName in ResourceNames %}
        {{ resourceName|raw }}
        <br/>
    {% endfor %}
{% else %}
    Elem: {{ ResourceName|raw }}
    <br/>
{% endif %}

{% if ResourceImage %}
    <div class="resource-image"><img src="{{ ScriptUrl|raw }}/{{ ResourceImage|raw }}"/></div>
{% endif %}

Megnevezés: {{ Title|raw }}<br/>
Leírás: {{ Description|nl2br|raw }}

{% if RepeatRanges|length > 0 %}
    <br/>
    A foglaás az alábbi dátumokon érvényes:
    <br/>
{% endif %}

{% for date in RepeatRanges %}
    {{ formatdate(date: date.GetBegin()) }}
    {% if not date.IsSameDate() %} - {{ formatdate(date: date.GetEnd()) }}{% endif %}
    <br/>
{% endfor %}

{% if Participants|default([])|length > 0 %}
    <br/>
    Résztvevők:
    {% for user in Participants %}
        {{ user.FullName() }}
        <br/>
    {% endfor %}
{% endif %}

{% if ParticipatingGuests|default([])|length > 0 %}
    {% for email in ParticipatingGuests %}
        {{ email|raw }}
        <br/>
    {% endfor %}
{% endif %}

{% if Invitees|default([])|length > 0 %}
    <br/>
    Meghívottak:
    {% for user in Invitees %}
        {{ user.FullName() }}
        <br/>
    {% endfor %}
{% endif %}

{% if InvitedGuests|default([])|length > 0 %}
    {% for email in InvitedGuests %}
        {{ email|raw }}
        <br/>
    {% endfor %}
{% endif %}

{% if Accessories|default([])|length > 0 %}
    <br/>
    Kiegészítők:
    <br/>
    {% for accessory in Accessories %}
        ({{ accessory.QuantityReserved }}) {{ accessory.Name|raw }}
        <br/>
    {% endfor %}
{% endif %}

{% if RequiresApproval %}
    <br/>
    A foglalt elemek legalább egyike jóváhagyást igényel. A foglalás függőben marad jóváhagyásáig.
{% endif %}

<br/>
Részt vesz? <a href="{{ ScriptUrl|raw }}/{{ AcceptUrl|raw }}">Igen</a> <a href="{{ ScriptUrl|raw }}/{{ DeclineUrl|raw }}">Nem</a>
