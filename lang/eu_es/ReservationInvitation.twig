    Erreserbaren xehetasunak:
    <br/>
    <br/>

    Hasiera: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    Amaiera: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>
    {% if ResourceNames|default([])|length > 1 %}
        Baliabideak:<br/>
        {% for resourceName in ResourceNames %}
            {{ resourceName|raw }}<br/>
        {% endfor %}
        {% else %}
        Baliabidea: {{ ResourceName|raw }}<br/>
    {% endif %}

    {% if ResourceImage %}
        <div class="resource-image"><img src="{{ ScriptUrl|raw }}/{{ ResourceImage|raw }}"/></div>
    {% endif %}

    Izenburua: {{ Title|raw }}<br/>
    Deskripzioa: {{ Description|nl2br|raw }}<br/>

    {% if RepeatDates|length > 0 %}
        <br/>
        Erreserba data hauetarako da:
        <br/>
    {% endif %}

    {% for date in RepeatDates %}
        {{ formatdate(date: date) }}<br/>
    {% endfor %}

    {% if Accessories|default([])|length > 0 %}
        <br/>Osagarriak:<br/>
        {% for accessory in Accessories %}
            ({{ accessory.QuantityReserved }}) {{ accessory.Name|raw }}<br/>
        {% endfor %}
    {% endif %}

    {% if RequiresApproval %}
        <br/>
        Erreserbatutako baliabideetako bat onartua izan behar du erabilia izan baino lehen. Erreserba hau zain geratuko da onartu arte.
    {% endif %}

    <br/>
    Bertaratuko? <a href="{{ ScriptUrl|raw }}/{{ AcceptUrl|raw }}">Bai</a> <a href="{{ ScriptUrl|raw }}/{{ DeclineUrl|raw }}">Ez</a>
    <br/>
    <br/>

    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Erreserba hau ikusi</a> |
    <a href="{{ ScriptUrl|raw }}/{{ ICalUrl|raw }}">Egutegi batera gehitu</a> |
    <a href="{{ ScriptUrl|raw }}">Saioa hasi LibreBooking-en</a>
