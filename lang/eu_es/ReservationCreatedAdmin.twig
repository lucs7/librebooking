    Erreserbaren xehetasunak:
    <br/>
    <br/>

    Erabiltzailea: {{ UserName|raw }}<br/>
    Hasiera: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    Amaiera: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>

    {% if Resources|default([])|length > 1 %}
        <strong>Baliabideak ({{ Resources|default([])|length }}):</strong> <br />
    {% else %}
        <strong>Baliabidea:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name }}</strong><br/>
        {% if resource.scheduleName %}<strong>Ordutegia:</strong> {{ resource.scheduleName }}<br/>{% endif %}
        <strong>Baliabide IDa:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>Kokapena:</strong> {{ resource.location }}<br/>{% endif %}
        {% if resource.contact %}<strong>Kontaktua:</strong> {{ resource.contact }}<br/>{% endif %}
        {% if resource.description %}<strong>Deskribapena:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>Oharrak:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>Baliabide administratzailea:</strong> {{ resource.resourceAdministrator }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>Baliabidearen xehetasunak:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label }}</strong></th>
                        <td valign="top">{{ row.displayValue|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}

    Izenburua: {{ Title|raw }}<br/>
    Deskripzioa: {{ Description|raw }}<br/>

    {% if RepeatDates|length > 0 %}
        <br/>
        Erreserba data hauetarako da:
        <br/>
    {% endif %}

    {% for date in RepeatDates %}
        {{ formatdate(date: date) }}<br/>
    {% endfor %}

    {% if Accessories|default([])|length > 0 %}
        <br/>Osagarriak:<br/>
        {% for accessory in Accessories %}
            ({{ accessory.QuantityReserved }}) {{ accessory.Name|raw }}<br/>
        {% endfor %}
    {% endif %}

    {% if Attributes|default([])|length > 0 %}
        <br/>
        {% for attribute in Attributes %}
            <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
        {% endfor %}
    {% endif %}

    {% if RequiresApproval %}
        <br/>
        Baliabideetako batek onarpena behar du erabilia izan aurretik. Mesedez ziurtatu erreserba eskaera hau onartu edo baztertzen dela.
    {% endif %}

    <br/>
    <br/>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Erreserba hau ikusi</a> | <a href="{{ ScriptUrl|raw }}">Saioa hasi LibreBooking-en</a>
