    Szczegóły rezerwacji:
    <br/>
    <br/>

    Początek: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    Koniec: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>

    {% if Resources|default([])|length > 1 %}
        <strong>Zasoby ({{ Resources|default([])|length }}):</strong> <br />
    {% else %}
        <strong>Zasób:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name }}</strong><br/>
        {% if resource.scheduleName %}<strong>Harmonogram:</strong> {{ resource.scheduleName }}<br/>{% endif %}
        <strong>ID zasobu:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>Lokalizacja:</strong> {{ resource.location }}<br/>{% endif %}
        {% if resource.contact %}<strong>Kontakt:</strong> {{ resource.contact }}<br/>{% endif %}
        {% if resource.description %}<strong>Opis:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>Uwagi:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>Administrator zasobu:</strong> {{ resource.resourceAdministrator }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>Szczegóły zasobu:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label }}</strong></th>
                        <td valign="top">{{ row.displayValue|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}

    Tytuł: {{ Title|raw }}<br/>
    Opis: {{ Description|nl2br|raw }}<br/>

    {% if RepeatDates|length > 0 %}
        <br/>
        Rezerwacja nastąpi w następujących terminach:
        <br/>
    {% endif %}

    {% for date in RepeatDates %}
        {{ formatdate(date: date) }}<br/>
    {% endfor %}

    {% if Accessories|default([])|length > 0 %}
        <br/>Akcesoria:<br/>
        {% for accessory in Accessories %}
            ({{ accessory.QuantityReserved }}) {{ accessory.Name|raw }}<br/>
        {% endfor %}
    {% endif %}

    {% if RequiresApproval %}
        <br/>
        Co najmniej jeden z zasobów wymaga zatwierdzenia. Ta rezerwacja będzie oczekiwała na zatwierdzenie.
    {% endif %}

    <br/>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Podgląd rezerwacji</a> |
    <a href="{{ ScriptUrl|raw }}/{{ ICalUrl|raw }}">Dodaj do Outlook'a</a> |
    <a href="{{ ScriptUrl|raw }}">Zaloguj się do LibreBooking</a>
