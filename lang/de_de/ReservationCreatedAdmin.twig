Hallo,<br/>
es wurde die folgende Reservierung erstellt.<br/>
Reservierungsdetails:<br/>
<br/>

    Benutzer: {{ UserName|raw }}<br/>
    Beginn: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    Ende: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>

    {% if Resources|default([])|length > 1 %}
        <strong>Ressourcen ({{ Resources|default([])|length }}):</strong> <br />
    {% else %}
        <strong>Ressource:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name }}</strong><br/>
        {% if resource.scheduleName %}<strong>Zeitplan:</strong> {{ resource.scheduleName }}<br/>{% endif %}
        <strong>Ressourcen-ID:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>Standort:</strong> {{ resource.location }}<br/>{% endif %}
        {% if resource.contact %}<strong>Kontakt:</strong> {{ resource.contact }}<br/>{% endif %}
        {% if resource.description %}<strong>Beschreibung:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>Notizen:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>Ressourcenadministrator:</strong> {{ resource.resourceAdministrator }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>Ressourcendetails:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label }}</strong></th>
                        <td valign="top">{{ row.displayValue|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}

    Titel: {{ Title|raw }}<br/>
    Beschreibung: {{ Description|raw }}<br/>

    {% if RepeatDates|length > 0 %}
        <br/>
        Ihre Reservierung gilt f&uuml;r den/die folgenden Tag(e):
        <br/>
    {% endif %}

    {% for date in RepeatDates %}
        {{ formatdate(date: date) }}<br/>
    {% endfor %}

    {% if Accessories|default([])|length > 0 %}
        <br/>Zubeh&ouml;r:<br/>
        {% for accessory in Accessories %}
            ({{ accessory.QuantityReserved }}) {{ accessory.Name|raw }}<br/>
        {% endfor %}
    {% endif %}

    {% if Attributes|default([])|length > 0 %}
        <br/>
        {% for attribute in Attributes %}
            <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
        {% endfor %}
    {% endif %}

    {% if RequiresApproval %}
        <br/>
        Eine oder mehrere Ressourcen ben&ouml;tigen eine Genehmigung.
        Diese Reservierung wird zur&uuml;ckgehalten, bis sie genehmigt ist.
    {% endif %}

    <br/>
    <br/>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Reservierung ansehen</a> | <a href="{{ ScriptUrl|raw }}">{{ AppTitle|raw }}-Anmeldung</a>
