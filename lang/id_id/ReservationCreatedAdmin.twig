    Rincian reservasi:
    <br/>
    <br/>

    Nama Pengguna: {{ UserName|raw }}
    Mulai: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    Akhir: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>

    {% if Resources|default([])|length > 1 %}
        <strong>Sumber Daya ({{ Resources|default([])|length }}):</strong> <br />
    {% else %}
        <strong>Sumber Daya:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name }}</strong><br/>
        {% if resource.scheduleName %}<strong>Jadwal:</strong> {{ resource.scheduleName }}<br/>{% endif %}
        <strong>ID Sumber Daya:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>Lokasi:</strong> {{ resource.location }}<br/>{% endif %}
        {% if resource.contact %}<strong>Kontak:</strong> {{ resource.contact }}<br/>{% endif %}
        {% if resource.description %}<strong>Deskripsi:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>Catatan:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>Administrator Sumber Daya:</strong> {{ resource.resourceAdministrator }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>Detail Sumber Daya:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label }}</strong></th>
                        <td valign="top">{{ row.displayValue|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}

    Judul: {{ Title|raw }}<br/>
    Penjelasan: {{ Description|raw }}<br/>

    {% if RepeatDates|length > 0 %}
        <br/>
        Reservasi diulang sampai tanggal:
        <br/>
    {% endif %}

    {% for date in RepeatDates %}
        {{ formatdate(date: date) }}<br/>
    {% endfor %}

    {% if Accessories|default([])|length > 0 %}
        <br/>Aksesoris:<br/>
        {% for accessory in Accessories %}
            ({{ accessory.QuantityReserved }}) {{ accessory.Name|raw }}<br/>
        {% endfor %}
    {% endif %}

    {% if RequiresApproval %}
        <br/>
        Satu atau resource lain yang direservasi membutuhkan persetujuan sebelum digunakan. Reservasi ini akan ditunda sampai disetujui.
    {% endif %}

    <br/>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Lihat reservasi ini</a> | <a href="{{ ScriptUrl|raw }}">Masuk LibreBooking</a>
