    Detalji o rezervaciji:
    <br/>
    <br/>

    Korisnik: {{ UserName|raw }}<br/>
    Pocetak: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    Kraj: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>

    {% if Resources|default([])|length > 1 %}
        <strong>Resursi ({{ Resources|default([])|length }}):</strong> <br />
    {% else %}
        <strong>Resurs:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name }}</strong><br/>
        {% if resource.scheduleName %}<strong>Raspored:</strong> {{ resource.scheduleName }}<br/>{% endif %}
        <strong>ID resursa:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>Lokacija:</strong> {{ resource.location }}<br/>{% endif %}
        {% if resource.contact %}<strong>Kontakt:</strong> {{ resource.contact }}<br/>{% endif %}
        {% if resource.description %}<strong>Opis:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>Bilješke:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>Administrator resursa:</strong> {{ resource.resourceAdministrator }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>Detalji resursa:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label }}</strong></th>
                        <td valign="top">{{ row.displayValue|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}

    Naziv: {{ Title|raw }}<br/>
    Opis: {{ Description|raw }}<br/>

    {% if RepeatDates|length > 0 %}
        <br/>
        Rezevacija va�i za navedeni datum:
        <br/>
    {% endif %}

    {% for date in RepeatDates %}
        {{ formatdate(date: date) }}<br/>
    {% endfor %}

    {% if Accessories|default([])|length > 0 %}
        <br/>Dodatno:<br/>
        {% for accessory in Accessories %}
            ({{ accessory.QuantityReserved }}) {{ accessory.Name|raw }}<br/>
        {% endfor %}
    {% endif %}

    {% if Attributes|default([])|length > 0 %}
        <br/>
        {% for attribute in Attributes %}
            <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
        {% endfor %}
    {% endif %}

    {% if RequiresApproval %}
        <br/>
        Jedan ili vi�e terena zahtijevaju odobrenje prije upotrebe. Molimo provjerite da li je rezervacija prihvacena ili odbijena.
    {% endif %}

    <br/>
    <br/>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">View this reservation</a> | <a href="{{ ScriptUrl|raw }}">Ulogiraj se</a>
