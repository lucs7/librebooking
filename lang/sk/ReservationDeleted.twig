Administrátorom boli zmazané tieto rezervácie:
<br/>
<br/>

Nadpis: {{ Title|raw }}<br/>
Popis: {{ Description|nl2br|raw }}<br/><br/>
{{ DeleteReason|nl2br|raw }}<br/>

Začiatok: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
Koniec: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>
{% if ResourceNames|default([])|length > 1 %}
    Ihriská:
    <br/>
    {% for resourceName in ResourceNames %}
        {{ resourceName|raw }}
        <br/>
    {% endfor %}
{% else %}
    Ihrisko: {{ ResourceName|raw }}
    <br/>
{% endif %}

{% if RepeatDates|length > 0 %}
    <br/>
    Došlo k zmazaniu všetkých týchto rezervovaných termínov:
    <br/>
{% endif %}

{% for date in RepeatDates %}
    {{ formatdate(date: date) }}
    <br/>
{% endfor %}

{% if Accessories|default([])|length > 0 %}
    <br/>
    Príslušenstvo:
    <br/>
    {% for accessory in Accessories %}
        ({{ accessory.QuantityReserved }}) {{ accessory.Name|raw }}
        <br/>
    {% endfor %}
{% endif %}
<a href="{{ ScriptUrl|raw }}">Prihlásiť sa do rezervačného systému</a>
