<p>{{ ParticipantDetails|raw }}
    {% if (InvitationAction == constant('InvitationAction::Decline') or InvitationAction == constant('InvitationAction::CancelAll') or InvitationAction == constant('InvitationAction::CancelInstance')) %}
        declinou o seu convite de participação na reserva.
    {% elseif (InvitationAction == constant('InvitationAction::Join') or InvitationAction == constant('InvitationAction::JoinAll')) %}
        aceitou o seu convite.
    {% else %}
        aceitou o seu convite de participação na reserva.
    {% endif %}
</p>
<p><strong>Detalhes da reserva:</strong></p>

<p>
    <strong>Início:</strong> {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    <strong>Fim:</strong> {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>
    <strong>Title:</strong> {{ Title|raw }}<br/>
    <strong>Descrição:</strong> {{ Description|nl2br|raw }}
    {% if Attributes|default([])|length > 0 %}
    <br/>
    {% for attribute in Attributes %}
    <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
    {% endfor %}
{% endif %}
</p>

<p>
    {% if ResourceNames|default([])|length > 1 %}
        <strong>Recursos ({{ ResourceNames|default([])|length }}):</strong>
        <br/>
        {% for resourceName in ResourceNames %}
            {{ resourceName|raw }}
            <br/>
        {% endfor %}
    {% else %}
        <strong>Recurso:</strong>
        {{ ResourceName|raw }}
        <br/>
    {% endif %}
</p>

{% if ResourceImage %}
    <div class="resource-image"><img alt="{{ ResourceName }}" src="{{ ScriptUrl|raw }}/{{ ResourceImage|raw }}"/></div>
{% endif %}

<p><strong>Número de referência:</strong> {{ ReferenceNumber|raw }}</p>

<p>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Ver esta reserva</a> |
    <a href="{{ ScriptUrl|raw }}">Entrar em {{ AppTitle|raw }}</a>
</p>
