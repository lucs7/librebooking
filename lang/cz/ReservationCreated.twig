    Vytvořeny tyto rezervace:
    <br/>
    <br/>

    Začátek: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    Konec: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>

    {% if Resources|default([])|length > 1 %}
        <strong>Zdroje ({{ Resources|default([])|length }}):</strong> <br />
    {% else %}
        <strong>Zdroj:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name }}</strong><br/>
        {% if resource.scheduleName %}<strong>Rozvrh:</strong> {{ resource.scheduleName }}<br/>{% endif %}
        <strong>ID zdroje:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>Umístění:</strong> {{ resource.location }}<br/>{% endif %}
        {% if resource.contact %}<strong>Kontakt:</strong> {{ resource.contact }}<br/>{% endif %}
        {% if resource.description %}<strong>Popis:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>Poznámky:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>Správce zdroje:</strong> {{ resource.resourceAdministrator }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>Detaily zdroje:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label }}</strong></th>
                        <td valign="top">{{ row.displayValue|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}

    Nadpis: {{ Title|raw }}<br/>
    Popis: {{ Description|nl2br|raw }}<br/>

    {% if RepeatDates|length > 0 %}
        <br/>
        Byly rezervovány všechny tyto termíny:
        <br/>
    {% endif %}

    {% for date in RepeatDates %}
        {{ formatdate(date: date) }}<br/>
    {% endfor %}

    {% if Accessories|default([])|length > 0 %}
        <br/>Příslušenství:<br/>
        {% for accessory in Accessories %}
            ({{ accessory.QuantityReserved }}) {{ accessory.Name|raw }}<br/>
        {% endfor %}
    {% endif %}

    {% if Attributes|default([])|length > 0 %}
        <br/>
        {% for attribute in Attributes %}
            <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
        {% endfor %}
    {% endif %}

    {% if RequiresApproval %}
        <br/>
        Jedna nebo více rezervací vyžaduje schválení od administrátora. Do té doby bude Vaše rezervace ve stavu schvalování.
    {% endif %}

    {% if ApprovedBy %}
        <br/>
    Rezervaci potvrdil a schválil: {{ ApprovedBy|raw }}
    {% endif %}

    <br/>
    <br/>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Zobrazit tuto rezervaci v systému</a> |
    <a href="{{ ScriptUrl|raw }}/{{ ICalUrl|raw }}">Přidat do Outlook</a> |
    <a href="{{ ScriptUrl|raw }}">Přihlásit se do rezervačního systému</a>
