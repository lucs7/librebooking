<p>La sua serie di prenotazioni per {{ ResourceName|raw }} terminerà il {{ formatdate(date: StartDate, key: 'reservation_email') }}.</p>
<p>Dettagli della prenotazione:</p>
<p>
    <strong>Inizio:</strong> {{ formatdate(date: StartDate, key: 'reservation_email') }}<br />
    <strong>Fine:</strong> {{ formatdate(date: EndDate, key: 'reservation_email') }}<br />
    <strong>Titolo:</strong> {{ Title|raw }}<br />
    <strong>Descrizione:</strong> {{ Description|nl2br|raw }}
</p>
{% if Attributes|default([])|length > 0 %}
    <p>
        {% for attribute in Attributes %}
            <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
        {% endfor %}
    </p>
{% endif %}
{% if ResourceNames|default([])|length > 1 %}
    <p>
        <strong>Risorse ({{ ResourceNames|default([])|length }}):</strong><br />
        {% for resourceName in ResourceNames %}
            {{ resourceName|raw }}<br />
        {% endfor %}
        </p>
{% else %}
    <p>
        <strong>Risorsa:</strong> {{ ResourceName|raw }}<br />
      </p>
{% endif %}
{% if ResourceImage %}
    <div class="resource-image"><img alt="{{ ResourceName }}" src="{{ ScriptUrl|raw }}/{{ ResourceImage|raw }}"/></div>
{% endif %}
<p>&nbsp;</p>
<p>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Dettagli di questa prenotazione</a> |
    <a href="{{ ScriptUrl|raw }}">Login su LibreBooking</a>
</p>
