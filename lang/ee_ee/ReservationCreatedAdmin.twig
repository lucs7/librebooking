    Broneeringu detailid:
    <br/>
    <br/>

    Kasutaja: {{ UserName|raw }}<br/>
    {% if CreatedBy %}
        Broneerija: {{ CreatedBy|raw }}
        <br/>
    {% endif %}
    Algus: {{ formatdate(date: StartDate, key: 'reservation_email') }}<br/>
    Lõpp: {{ formatdate(date: EndDate, key: 'reservation_email') }}<br/>

    {% if Resources|default([])|length > 1 %}
        <strong>Ressursid ({{ Resources|default([])|length }}):</strong> <br />
    {% else %}
        <strong>Ressurss:</strong><br/>
    {% endif %}
    {% for resource in Resources %}
        <strong>{{ resource.name }}</strong><br/>
        {% if resource.scheduleName %}<strong>Graafik:</strong> {{ resource.scheduleName }}<br/>{% endif %}
        <strong>Ressursi ID:</strong> {{ resource.id }}<br/>
        {% if resource.location %}<strong>Asukoht:</strong> {{ resource.location }}<br/>{% endif %}
        {% if resource.contact %}<strong>Kontakt:</strong> {{ resource.contact }}<br/>{% endif %}
        {% if resource.description %}<strong>Kirjeldus:</strong> {{ resource.description|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.notes %}<strong>Märkused:</strong> {{ resource.notes|sanitize_rich_text|url2link|nl2br|raw }}<br/>{% endif %}
        {% if resource.resourceAdministrator %}<strong>Ressursi administraator:</strong> {{ resource.resourceAdministrator }}<br/>{% endif %}

        {% if resource.attributeRows|default([])|length > 0 %}
            <strong>Ressursi üksikasjad:</strong><br/>
            <table cellpadding="4" cellspacing="0" border="1" style="border-collapse: collapse; margin-top: 4px;">
                {% for row in resource.attributeRows %}
                    <tr>
                        <th scope="row" valign="top" style="text-align: left;"><strong>{{ row.label }}</strong></th>
                        <td valign="top">{{ row.displayValue|nl2br }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}

        {% if resource.image %}
            <div class="resource-image"><img alt="{{ resource.name }}" src="{{ ScriptUrl|raw }}/{{ resource.image }}"/></div>
        {% endif %}

        {% if not loop.last %}<br/>{% endif %}
    {% endfor %}

    Pealkiri: {{ Title|raw }}<br/>
    Kirjeldus: {{ Description|nl2br|raw }}

    {% if RepeatDates|length > 0 %}
        <br/>
        Broneering esineb järgneval kuupäeval:
        <br/>
    {% endif %}

    {% for date in RepeatDates %}
        {{ formatdate(date: date) }}<br/>
    {% endfor %}

    {% if Accessories|default([])|length > 0 %}
        <br/>Accessories:<br/>
        {% for accessory in Accessories %}
            ({{ accessory.QuantityReserved }}) {{ accessory.Name|raw }}<br/>
        {% endfor %}
    {% endif %}

    {% if Attributes|default([])|length > 0 %}
        <br/>
        {% for attribute in Attributes %}
            <div>{{ control('AttributeControl', {attribute: attribute, readonly: true}) }}</div>
        {% endfor %}
    {% endif %}

    {% if RequiresApproval %}
        <br/>
        One or more of the resources reserved require approval before usage.  Please ensure that this reservation request is approved or rejected.
    {% endif %}

    <br/>
    <br/>
    <a href="{{ ScriptUrl|raw }}/{{ ReservationUrl|raw }}">Vaata seda broneeringut</a> | <a href="{{ ScriptUrl|raw }}">Logi sisse Rannahalli kalendrisse</a>
