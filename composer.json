{
    "name": "librebooking/librebooking",
    "description": "LibreBooking - Open Source Reservation System",
    "version": "3.0.3",
    "keywords": [
        "booking",
        "reservation",
        "scheduling"
    ],
    "homepage": "https://librebooking.org",
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "LibreBooking Contributors",
            "homepage": "https://github.com/librebooking/librebooking"
        }
    ],
    "support": {
        "issues": "https://github.com/librebooking/librebooking/issues",
        "source": "https://github.com/librebooking/librebooking"
    },
    "autoload": {},
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7.1",
        "phpcompatibility/php-compatibility": "^9.3.5",
        "kint-php/kint": "^4.2.3",
        "phpunit/phpunit": "^11.3",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.85"
    },
    "require": {
        "php": ">=8.2",
        "smarty/smarty": "^5.5",
        "stripe/stripe-php": "^10.2",
        "monolog/monolog": "^2.9",
        "google/recaptcha": "1.2.*",
        "gregwar/captcha": "^1.3",
        "google/apiclient": "^2.0",
        "microsoft/microsoft-graph": "^2.0",
        "nickdnk/graph-sdk": "^7.0",
        "mobiledetect/mobiledetectlib": "^4.8",
        "bacon/bacon-qr-code": "^3.0",
        "mibe/feedwriter": "^1.1",
        "sabre/vobject": "^4.5",
        "egulias/email-validator": "^4.0",
        "phpmailer/phpmailer": "^6.10",
        "claviska/simpleimage": "^4.2",
        "mashape/unirest-php": "^3.0"
    },
    "scripts": {
        "install-tools": "phive install --trust-gpg-keys",
        "build": "./tools/phing",
        "fix": "./vendor/bin/php-cs-fixer fix -v",
        "lint": "./vendor/bin/php-cs-fixer fix -vv --dry-run",
        "phpunit": "./vendor/bin/phpunit",
        "stan": "./vendor/bin/phpstan --memory-limit=2G analyse",
        "stan:baseline": "./vendor/bin/phpstan analyze --generate-baseline",
        "cs": "./vendor/bin/phpcs -p --standard=PSR12 --ignore=vendor/*,tools/*,.git/*,tpl_c/*,build/*,.phpdoc/*,var/*,Web/scripts/*,Web/css/* .",
        "cs:fix": "./vendor/bin/phpcbf -p --standard=PSR12 --ignore=vendor/*,tools/*,.git/*,tpl_c/*,build/*,.phpdoc/*,var/*,Web/scripts/*,Web/css/* .",
        "security": "composer audit",
        "compat": "phpcs -p ./ --standard=vendor/phpcompatibility/php-compatibility/PHPCompatibility --report-full=./php8-report.log --ignore=./vendor/*,./tools/*,./.git/*,./tpl_c/*,./build/*,./.phpdoc/*,./var/*,./Web/scripts/*,./Web/css/* --runtime-set testVersion 8.2",
        "check": [
            "@lint",
            "@cs",
            "@stan"
        ],
        "test": [
            "@check",
            "@phpunit"
        ],
        "test:all": [
            "@security",
            "@compat",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    }
}
